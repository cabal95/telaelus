{
  "$schema": "../scenario.schema.json",
  "name": "renewables",
  "description": "Renewables beside the HQ: a Forester on Water and Power grows its trees (they rise as they grow) and a Lumber Camp cuts them once grown; a Quarry beside a mountain yields Stone; a Deep Mine on a Laterite motherlode yields its chosen resource and its panel shows the site and the Output picker; a worked-out Crude Oil cell shows its marker and names it on hover; a Rock Crusher supplies Sand from Stone.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 60 } },
    { "seedStockpile": { "type": "Stone", "amount": 20 } },
    { "comment": "Power and Water: a Burner Generator, and two Water Pumps on the pond at map cell (13, 4).", "placeBuilding": { "type": "BurnerGenerator", "anchor": [52, 8] } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[13, 4]] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [52, 14] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [54, 14] } },
    { "teleportPlayer": { "x": 42, "z": 22 } },

    { "comment": "The Forester's plot is map cell (12, 3); a Lumber Camp stands beside it.", "placeBuilding": { "type": "Forester", "anchor": [48, 12] } },
    { "placeBuilding": { "type": "LumberCamp", "anchor": [45, 15] } },
    { "wait": 2 },
    { "expect": "fields[0].growing", "equals": true },
    { "expect": "buildings[4].online", "equals": true },
    { "expect": "capacity.water", "equals": { "supply": 8, "demand": 5, "speed": 1, "state": "normal" } },
    { "comment": "Nothing cuts a growing plot.", "expect": "buildings[5].idleReason", "equals": "No fields in range" },

    { "comment": "A mountain at map cell (11, 2) and a Quarry beside it.", "changeTiles": { "feature": "Mountain", "cells": [[11, 2]] } },
    { "placeBuilding": { "type": "Quarry", "anchor": [48, 8] } },
    { "comment": "A Laterite at map cells (9..10, 1..2) and a Deep Mine on its center; a Small Hub brings it online.", "placeMotherlode": { "kind": "Laterite", "mapCell": [9, 1] } },
    { "placeBuilding": { "type": "DeepMine", "anchor": [38, 6] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [45, 13] } },
    { "setWorkedOut": { "mapCell": [8, 5], "deposit": "CrudeOil" } },
    { "placeBuilding": { "type": "RockCrusher", "anchor": [56, 14] } },
    { "comment": "A second Burner Generator: the Forester, Quarry, Deep Mine, and Rock Crusher draw 57 Power.", "placeBuilding": { "type": "BurnerGenerator", "anchor": [52, 0] } },
    { "wait": 2700 },
    { "comment": "Half grown at 90 s.", "expect": "fields[0].growing", "equals": true },
    { "expect": "buildings[7].online", "equals": true },
    { "expect": "buildings[7].producing", "equals": "IronOre" },
    { "expect": "capacity.sand.supply", "equals": 4 },
    { "screenshot": "half-grown" },

    { "wait": 2800 },
    { "expect": "fields[0].growing", "equals": false },
    { "expect": "fields[0].amount", "equals": 150 },
    { "wait": 200 },
    { "comment": "The Lumber Camp has started on the grown plot.", "expect": "buildings[5].status", "equals": "working" },
    { "expect": "fields[1].motherlode", "equals": "Laterite" },
    { "screenshot": "grown" },

    { "aimAt": { "world": [40, 8] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.rows.site", "equals": "Laterite motherlode" },
    { "expect": "ui.output", "equals": "Iron Ore, every 5 s" },
    { "screenshot": "deep-mine" },
    { "press": "Escape" },
    { "wait": 2 },

    { "aimAt": { "world": [34, 22] } },
    { "wait": 2 },
    { "expect": "ui.worldTip", "equals": ["Worked-out Crude Oil"] },
    { "expect": "workedOut", "equals": [{ "mapCell": [8, 5], "deposit": "CrudeOil" }] }
  ]
}
