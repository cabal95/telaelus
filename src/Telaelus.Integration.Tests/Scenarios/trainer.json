{
  "$schema": "../scenario.schema.json",
  "name": "trainer",
  "description": "The trainer in a generated world: the first New Game's question starts it; each of its 13 steps shows on the step card and is done by doing it (walking, panning, zooming, bringing the view back, gathering Wood, the inventory, choosing, turning, and placing a Lumber Camp, its panel, collecting from it, the network, research and the game menu), reading Done before the next; the pointer ring marks the trees and the camp; a step already done completes at once; it ends with a lasting toast; the card's X asks to stop it; a save keeps the step.",
  "steps": [
    { "newGame": {} },
    { "wait": 2 },
    { "comment": "Test runs never ask on their own.", "expect": "ui.open", "equals": null },
    { "expect": "ui.trainer", "equals": null },
    { "askTrainer": {} },
    { "wait": 2 },
    { "expect": "ui.choice", "equals": "Learn to play? The trainer shows you the controls, one step at a time." },
    { "screenshot": "prompt" },
    { "clickUi": { "id": "choice/yes" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "ui.trainer", "equals": { "step": 1, "total": 13, "header": "Trainer 1 / 13", "text": "Right-click the ground to walk there.", "hint": "Ctrl + left click works too.", "done": false, "pointer": null } },

    { "comment": "1: walk (the spawn is (130, 130)).", "aimAt": { "world": [136, 136] } },
    { "wait": 1 },
    { "click": { "button": "right" } },
    { "wait": 30 },
    { "expect": "ui.trainer.done", "equals": true },
    { "expect": "ui.trainer.header", "equals": "Done" },
    { "screenshot": "done" },
    { "wait": 32 },
    { "expect": "ui.trainer.step", "equals": 2 },

    { "comment": "2: pan.", "drag": { "button": "right", "from": [640, 360], "to": [380, 200], "frames": 10 } },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 3 },

    { "comment": "3: zoom both ways (as the wheel does).", "cameraZoom": { "size": 20 } },
    { "wait": 2 },
    { "cameraZoom": { "size": 34 } },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 4 },
    { "cameraZoom": { "size": 28 } },

    { "comment": "4: bring the view back.", "press": "Space" },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 5 },
    { "comment": "The ring marks the nearest Wood: after the walk, the starter field at map cell (34, 27).", "expect": "ui.trainer.pointer", "equals": [138, 110] },
    { "screenshot": "gather" },

    { "comment": "5: gather Wood; 14 seeded, the 15th by hand (3 s).", "seedStockpile": { "type": "Wood", "amount": 14 } },
    { "teleportPlayer": { "x": 138, "z": 113 } },
    { "wait": 2 },
    { "keyDown": "E" },
    { "wait": 100 },
    { "keyUp": "E" },
    { "comment": "15 Wood affords the Lumber Camp.", "expect": "stockpile.Wood", "equals": 15 },
    { "wait": 32 },
    { "expect": "ui.trainer.step", "equals": 6 },

    { "comment": "6: the inventory.", "press": "I" },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 7 },

    { "comment": "7: the build menu's Lumber Camp.", "press": "B" },
    { "wait": 2 },
    { "clickUi": { "id": "buildMenu/LumberCamp" } },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 8 },

    { "comment": "8: turn it.", "press": "R" },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 9 },

    { "comment": "9: place it east of the trees, inside the HQ's network.", "aimAt": { "world": [135, 113] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 40 },
    { "expect": "buildings[1].type", "equals": "LumberCamp" },
    { "expect": "ui.trainer.step", "equals": 10 },
    { "expect": "ui.trainer.pointer", "equals": [135, 113] },
    { "screenshot": "camp" },

    { "comment": "10: its panel.", "press": "Escape" },
    { "wait": 2 },
    { "aimAt": { "world": [135, 113] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 11 },

    { "comment": "11: collect from it by hand.", "fillBuffer": { "anchor": [134, 112], "type": "Wood", "amount": 3 } },
    { "teleportPlayer": { "x": 135, "z": 115.5 } },
    { "wait": 2 },
    { "keyDown": "E" },
    { "wait": 20 },
    { "keyUp": "E" },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 12 },

    { "comment": "12: the network.", "press": "N" },
    { "wait": 40 },
    { "expect": "ui.trainer.step", "equals": 13 },
    { "screenshot": "network" },

    { "comment": "13: research, then the game menu (Escape closes the panel open, then opens the menu).", "press": "Escape" },
    { "wait": 2 },
    { "press": "T" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "researchTree" },
    { "press": "Escape" },
    { "wait": 2 },
    { "press": "Escape" },
    { "wait": 40 },
    { "expect": "ui.open", "equals": "gameMenu" },
    { "expect": "ui.trainer", "equals": null },
    { "expect": "ui.toasts[0].title", "equals": "Trainer complete" },
    { "screenshot": "complete" },
    { "press": "Escape" },
    { "wait": 2 },

    { "comment": "A step already done completes at once: the network overlay is still on.", "startTrainer": { "step": 12 } },
    { "wait": 2 },
    { "expect": "ui.trainer.done", "equals": true },

    { "comment": "The card's X asks to stop; Keep going keeps it.", "startTrainer": { "step": 3 } },
    { "wait": 2 },
    { "clickUi": { "id": "trainer/close" } },
    { "wait": 2 },
    { "expect": "ui.choice", "equals": "Stop the trainer? The game menu's Trainer starts it again." },
    { "clickUi": { "id": "choice/no" } },
    { "wait": 2 },
    { "expect": "ui.trainer.step", "equals": 3 },

    { "comment": "A save keeps the step.", "saveGame": { "name": "Training" } },
    { "loadGame": { "name": "Training" } },
    { "wait": 2 },
    { "expect": "ui.trainer.step", "equals": 3 },

    { "comment": "Stop ends it.", "clickUi": { "id": "trainer/close" } },
    { "wait": 2 },
    { "clickUi": { "id": "choice/yes" } },
    { "wait": 2 },
    { "expect": "ui.trainer", "equals": null },

    { "comment": "The game menu's Trainer starts it again from the first step.", "press": "Escape" },
    { "wait": 2 },
    { "clickUi": { "id": "gameMenu/Trainer" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "ui.trainer.step", "equals": 1 }
  ]
}
