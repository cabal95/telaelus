{
  "$schema": "../scenario.schema.json",
  "name": "building-detail",
  "description": "Clicking a placed building opens its detail side panel: the status strip (the on/off toggle green while on, the network), the state line in its tone, and the status rows; the world keeping its hover with it open, turning it off and on, switching to another building, closing by empty ground, B, and Escape, and destroying with a confirming second click for half the cost back (shown in the Destroy button's tooltip).",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "A Mine centered at (45, 35) has these two Iron Ore fields and the Stone in range.", "placeResource": { "type": "IronOre", "mapCell": [10, 9] } },
    { "placeResource": { "type": "IronOre", "mapCell": [11, 10] } },
    { "placeResource": { "type": "Stone", "mapCell": [12, 8] } },
    { "placeBuilding": { "type": "Mine", "anchor": [44, 34] } },
    { "comment": "A Lumber Camp with no trees in range.", "placeBuilding": { "type": "LumberCamp", "anchor": [28, 28] } },
    { "comment": "Small Hubs from the HQ put the Mine and the camp online.", "placeBuilding": { "type": "SmallHub", "anchor": [50, 20] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [46, 30] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [37, 30] } },
    { "wait": 2 },

    { "aimAt": { "world": [45, 35] } },
    { "wait": 2 },
    { "comment": "The building under the pointer is outlined.", "expect": "hoveredBuilding", "notEquals": null },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "The strip leads with the on/off toggle, green while on, then the network.", "expect": "ui.strip[0]", "equals": { "id": "switch", "value": null, "tone": "good", "tip": "On: click to turn off" } },
    { "expect": "ui.strip[1]", "equals": { "id": "network", "value": null, "tone": "good", "tip": "Online: connected to the network" } },
    { "expect": "ui.state", "equals": "Working" },
    { "expect": "ui.stateTone", "equals": "normal" },
    { "comment": "Two Grassland Iron Ore fields of 1000 and one Stone field of 1000.", "expect": "ui.rows.inRange", "equals": "Iron Ore 2 (2000), Stone 1 (1000)" },
    { "expect": "ui.rows.workingOn", "equals": "Iron Ore (1000 left)" },
    { "expect": "ui.destroy", "equals": "Destroy" },
    { "expect": "ui.destroyTip", "equals": "Refund: 13 Wood, 8 Stone" },
    { "comment": "A side panel is a third of the window wide, whatever it holds.", "expect": "ui.width", "approx": 426.7 },
    { "comment": "The refund shows on hover.", "hoverUi": { "id": "buildingDetail/destroy" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["Refund: 13 Wood, 8 Stone"] },
    { "screenshot": "destroy-tip" },
    { "comment": "The open building keeps its outline with the pointer elsewhere.", "aimAt": { "world": [36, 28] } },
    { "wait": 1 },
    { "expect": "hoveredBuilding", "equals": null },
    { "expect": "focusedBuilding", "notEquals": null },
    { "comment": "The wheel over the panel, even past the end of its scroll, never zooms the world.", "scrollUi": { "id": "buildingDetail/toggle", "ticks": 6 } },
    { "wait": 1 },
    { "expect": "camera.zoom", "approx": 28 },
    { "screenshot": "detail" },

    { "comment": "A side panel leaves the world its input: the Lumber Camp outlines under the pointer with it open.", "aimAt": { "world": [29, 29] } },
    { "wait": 2 },
    { "expect": "hoveredBuilding", "notEquals": null },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "wait": 60 },
    { "screenshot": "detail-turned" },

    { "clickUi": { "id": "buildingDetail/toggle" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": false },
    { "comment": "Off is the player's choice: the toggle and the state go dim.", "expect": "ui.strip[0].tone", "equals": "dim" },
    { "expect": "ui.strip[0].tip", "equals": "Off: click to turn on" },
    { "expect": "ui.state", "equals": "Idle: Switched off" },
    { "expect": "ui.stateTone", "equals": "dim" },
    { "clickUi": { "id": "buildingDetail/toggle" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": true },

    { "comment": "Clicking another building switches the panel to it.", "aimAt": { "world": [29, 29] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "A problem shows in the warning color.", "expect": "ui.state", "equals": "Idle: No fields in range" },
    { "expect": "ui.stateTone", "equals": "warning" },
    { "expect": "ui.rows.inRange", "equals": "none" },
    { "comment": "Only a building that works more than one type says what it is on.", "expect": "ui.rows.workingOn", "exists": false },

    { "comment": "A click on empty ground closes the panel.", "aimAt": { "world": [36, 28] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },
    { "expect": "focusedBuilding", "equals": null },

    { "aimAt": { "world": [29, 29] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "press": "B" },
    { "wait": 1 },
    { "comment": "Another overlay opening closes the panel.", "expect": "ui.open", "equals": "buildMenu" },
    { "press": "Escape" },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "aimAt": { "world": [45, 35] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "clickUi": { "id": "buildingDetail/destroy" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "comment": "The first click only arms the button.", "expect": "ui.destroy", "equals": "Confirm destroy" },
    { "comment": "Six buildings: the HQ, the Mine, the camp, and three hubs.", "expect": "buildings[5]", "exists": true },
    { "clickUi": { "id": "buildingDetail/destroy" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "buildings[5]", "exists": false },
    { "expect": "buildings[1].type", "equals": "LumberCamp" },
    { "expect": "stockpile.Wood", "equals": 13 },
    { "expect": "stockpile.Stone", "equals": 8 }
  ]
}
