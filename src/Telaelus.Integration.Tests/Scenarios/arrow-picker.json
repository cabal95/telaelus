{
  "$schema": "../scenario.schema.json",
  "name": "arrow-picker",
  "description": "The arrow picker (the inventory's): the current choice's cell keeps one width, the widest choice's, so the right arrow never moves as the label changes; an arrow is disabled at its end; a hidden choice (a locked tier) is skipped, so the right arrow stops before it and moves on once it shows.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "wait": 2 },
    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Resources" },
    { "comment": "At the first choice the left arrow is disabled.", "expect": "ui.inventoryArrows", "equals": { "prev": false, "next": true } },
    { "expect": "ui.inventoryPicker", "equals": { "currentWidth": 86, "nextX": 126 } },
    { "screenshot": "resources" },

    { "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 1" },
    { "comment": "The shorter label sits centered in the same cell; the right arrow has not moved.", "expect": "ui.inventoryPicker", "equals": { "currentWidth": 86, "nextX": 126 } },
    { "comment": "Tier 2 is hidden (locked), so the right arrow is disabled.", "expect": "ui.inventoryArrows", "equals": { "prev": true, "next": false } },
    { "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 1" },
    { "screenshot": "tier-1" },

    { "comment": "Electronics as well as Steel Works: Tiers 2 and 3 show, Tier 4 stays hidden.", "setResearchProgress": { "project": "SteelWorks", "seconds": 1200 } },
    { "setResearchProgress": { "project": "Electronics", "seconds": 1800 } },
    { "wait": 2 },
    { "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 3" },
    { "expect": "ui.inventoryArrows", "equals": { "prev": true, "next": false } },
    { "comment": "The left arrow walks back to the start.", "clickUi": { "id": "inventory/tier/prev" } },
    { "wait": 2 },
    { "clickUi": { "id": "inventory/tier/prev" } },
    { "wait": 2 },
    { "clickUi": { "id": "inventory/tier/prev" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Resources" },
    { "expect": "ui.inventoryArrows", "equals": { "prev": false, "next": true } }
  ]
}
