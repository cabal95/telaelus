{
  "$schema": "../scenario.schema.json",
  "name": "place-on-player",
  "description": "A building cannot be placed with the player inside its footprint; the ghost shows it, a click does nothing, and the player can still walk away. Placing right next to the player works.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Buildings cost resources and unlock once their materials are held.", "seedStockpile": { "type": "Wood", "amount": 500 } },
    { "seedStockpile": { "type": "Stone", "amount": 500 } },
    { "seedStockpile": { "type": "Iron", "amount": 500 } },
    { "wait": 2 },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Smelter" } },
    { "wait": 1 },
    { "comment": "The player stands in cell (32, 32); a Smelter aimed there covers it.", "aimAt": { "cell": [32, 32] } },
    { "wait": 2 },
    { "screenshot": "ghost-over-player" },
    { "expect": "build.ghost.placeable", "equals": false },
    { "click": {} },
    { "wait": 2 },
    { "comment": "Only the HQ stands.", "expect": "buildings[1]", "exists": false },
    { "comment": "Cell (35, 32) puts the 3x3 Smelter at anchor (34, 31), just clear of the player.", "aimAt": { "cell": [35, 32] } },
    { "wait": 2 },
    { "expect": "build.ghost.placeable", "equals": true },
    { "click": {} },
    { "wait": 2 },
    { "screenshot": "placed-beside-player" },
    { "expect": "buildings[1].anchor", "equals": [34, 31] },
    { "press": "Escape" },
    { "wait": 1 },
    { "comment": "A right click on open ground walks the player away.", "aimAt": { "cell": [28, 33] } },
    { "click": { "button": "right" } },
    { "wait": 15 },
    { "expect": "player.position[0]", "lte": 31.5 }
  ]
}
