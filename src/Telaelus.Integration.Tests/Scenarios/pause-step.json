{
  "$schema": "../scenario.schema.json",
  "name": "pause-step",
  "description": "While paused, input (a click to walk, a key) waits for step, and step runs exact frames (one sim tick each at --fixed-fps 30) then stays paused.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Buildings cost resources and unlock once their materials are held.", "seedStockpile": { "type": "Wood", "amount": 500 } },
    { "seedStockpile": { "type": "Stone", "amount": 500 } },
    { "seedStockpile": { "type": "Iron", "amount": 500 } },
    { "aimAt": { "world": [40.5, 32.5] } },
    { "pause": {} },
    { "click": { "button": "right" } },
    { "comment": "Queued, not delivered: nothing walks while paused.", "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 32 },
    { "step": { "frames": 1 } },
    { "expect": "paused", "equals": true },
    { "comment": "The press arrives with this step; a click walks on its release, which comes with the next.", "expect": "player.walking", "equals": false },
    { "step": { "frames": 1 } },
    { "expect": "player.walking", "equals": true },
    { "comment": "One tick at 6 units per second toward the first cell's center, (33.5, 32.5): 0.2 times 1.5 / sqrt(2.5) on X.", "expect": "player.position[0]", "approx": 32.1897, "tolerance": 0.002 },
    { "step": { "frames": 4 } },
    { "expect": "player.position[0]", "approx": 32.9487, "tolerance": 0.002 },
    { "resume": {} },
    { "comment": "Select the Refinery through the menu, then pause again; R is checked while paused.", "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Refinery" } },
    { "wait": 1 },
    { "pause": {} },
    { "press": "R" },
    { "expect": "build.facing", "equals": "North" },
    { "step": { "frames": 1 } },
    { "expect": "build.facing", "equals": "East" },
    { "expect": "paused", "equals": true },
    { "resume": {} },
    { "wait": 2 },
    { "expect": "paused", "equals": false },
    { "expect": "input.heldKeys", "equals": [] }
  ]
}
