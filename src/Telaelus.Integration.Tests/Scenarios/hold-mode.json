{
  "$schema": "../scenario.schema.json",
  "name": "hold-mode",
  "description": "A Smelter in Hold mode keeps Iron in storage at its target: the target starts at the stock, + and - step it, the Smelter idles \"Holding\" once storage holds the target and starts again when Iron is used; back in Queue mode (clicking the Mode picker's Queue cell) its queue is empty.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 20 } },
    { "seedStockpile": { "type": "IronOre", "amount": 10 } },
    { "seedStockpile": { "type": "Iron", "amount": 2 } },
    { "teleportPlayer": { "x": 44, "z": 14 } },
    { "placeBuilding": { "type": "Smelter", "anchor": [48, 4] } },
    { "wait": 2 },
    { "aimAt": { "world": [49.5, 5.5] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.mode", "equals": "Queue" },
    { "expect": "ui.hold", "equals": null },

    { "comment": "Hold starts at the 2 Iron in storage, already reached.", "selectUi": { "id": "buildingDetail/mode", "item": "Hold" } },
    { "wait": 2 },
    { "expect": "ui.mode", "equals": "Hold" },
    { "expect": "ui.hold", "equals": { "target": "2", "line": "In storage: 2 / 2 Iron" } },
    { "expect": "ui.queue", "equals": null },
    { "expect": "ui.order", "equals": null },
    { "expect": "buildings[1].hold", "equals": { "recipe": "Iron", "target": 2 } },
    { "expect": "buildings[1].idleReason", "equals": "Holding: 2 Iron" },

    { "comment": "One more: it makes one Iron (a 16 s cycle, 12.3 s on Coal) and holds again.", "clickUi": { "id": "buildingDetail/holdMore" } },
    { "wait": 2 },
    { "expect": "ui.hold", "equals": { "target": "3", "line": "In storage: 2 / 3 Iron" } },
    { "expect": "buildings[1].idleReason", "equals": null },
    { "screenshot": "holding-making" },
    { "wait": 390 },
    { "expect": "stockpile.Iron", "equals": 3 },
    { "expect": "buildings[1].idleReason", "equals": "Holding: 3 Iron" },
    { "screenshot": "holding" },

    { "comment": "Iron used elsewhere: it makes it back.", "seedStockpile": { "type": "Iron", "amount": -2 } },
    { "wait": 2 },
    { "expect": "buildings[1].idleReason", "equals": null },
    { "wait": 760 },
    { "expect": "stockpile.Iron", "equals": 3 },
    { "expect": "buildings[1].idleReason", "equals": "Holding: 3 Iron" },

    { "comment": "- steps down, and not below one cycle.", "holdUi": { "id": "buildingDetail/holdLess", "frames": 30 } },
    { "wait": 2 },
    { "expect": "ui.hold.target", "equals": "1" },

    { "comment": "Back to Queue mode by clicking its cell: an empty queue.", "clickUi": { "id": "buildingDetail/mode/Queue" } },
    { "wait": 2 },
    { "expect": "ui.mode", "equals": "Queue" },
    { "expect": "ui.hold", "equals": null },
    { "expect": "ui.queue", "equals": ["Queue empty"] },
    { "expect": "buildings[1].hold", "equals": null },
    { "expect": "buildings[1].idleReason", "equals": "Queue empty" }
  ]
}
