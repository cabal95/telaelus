{
  "$schema": "../scenario.schema.json",
  "name": "storage",
  "description": "Storage limits: with Wood at the HQ's 100 the top bar shows it full in the danger color and the harvest hint says Storage full; a Silo raises the limit and harvesting resumes; the inventory pins and unpins resources on the top bar; the Silo's detail panel lists what it adds.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Wood", "amount": 100 } },
    { "comment": "Map cell (8, 7) spans z 28..32; the player stands 1 unit past its edge.", "placeResource": { "type": "Wood", "mapCell": [8, 7] } },
    { "teleportPlayer": { "x": 33.5, "z": 33 } },
    { "wait": 2 },
    { "expect": "ui.topBar.items[0]", "equals": { "type": "Wood", "amount": 100, "limit": 100, "full": true, "text": "100", "tone": "danger" } },
    { "expect": "ui.hint.text", "equals": "[E] Harvest Wood" },
    { "expect": "ui.hint.storageFull", "equals": true },
    { "keyDown": "E" },
    { "wait": 120 },
    { "comment": "4 seconds of harvesting add nothing while Wood is full.", "expect": "stockpile.Wood", "equals": 100 },
    { "screenshot": "storage-full" },
    { "keyUp": "E" },

    { "comment": "A Silo holds Wood until changed: +300, once Small Hubs link it back to the HQ in the north-east corner.", "placeBuilding": { "type": "Silo", "anchor": [40, 40] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [52, 18] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [46, 27] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [42, 35] } },
    { "wait": 2 },
    { "expect": "ui.topBar.items[0]", "equals": { "type": "Wood", "amount": 100, "limit": 400, "full": false, "text": "100", "tone": "normal" } },
    { "expect": "ui.hint.storageFull", "equals": false },
    { "keyDown": "E" },
    { "wait": 100 },
    { "keyUp": "E" },
    { "comment": "Wood takes 3 seconds a unit by hand.", "expect": "stockpile.Wood", "equals": 101 },

    { "comment": "A newly discovered resource pins itself while the bar has room.", "seedStockpile": { "type": "Iron", "amount": 5 } },
    { "wait": 2 },
    { "expect": "ui.topBar.items[1]", "equals": { "type": "Iron", "amount": 5, "limit": null, "full": false, "text": "5", "tone": "normal" } },
    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.cargo", "equals": "Cargo (5 / 150)" },
    { "clickUi": { "id": "inventory/pin/Wood" } },
    { "wait": 2 },
    { "comment": "Unpinning Wood leaves Iron first on the top bar.", "expect": "ui.topBar.items[0].type", "equals": "Iron" },
    { "clickUi": { "id": "inventory/pin/Wood" } },
    { "wait": 2 },
    { "comment": "Pins keep table order: Wood before Iron.", "expect": "ui.topBar.items[0].type", "equals": "Wood" },
    { "expect": "ui.topBar.items[1].type", "equals": "Iron" },

    { "comment": "Six more discoveries fill the bar to 8; a ninth does not pin itself.", "seedStockpile": { "type": "Stone", "amount": 1 } },
    { "seedStockpile": { "type": "Coal", "amount": 1 } },
    { "seedStockpile": { "type": "Copper", "amount": 1 } },
    { "seedStockpile": { "type": "Steel", "amount": 1 } },
    { "seedStockpile": { "type": "Glass", "amount": 1 } },
    { "seedStockpile": { "type": "Sulfur", "amount": 1 } },
    { "wait": 2 },
    { "expect": "ui.topBar.items[7]", "exists": true },
    { "seedStockpile": { "type": "Cement", "amount": 1 } },
    { "wait": 2 },
    { "expect": "ui.topBar.items[8]", "exists": false },
    { "screenshot": "pinned" },
    { "press": "I" },
    { "wait": 1 },

    { "aimAt": { "world": [41, 41] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.adds", "equals": { "Wood": "+300" } },
    { "expect": "ui.destroy", "equals": "Destroy" },
    { "expect": "ui.destroyTip", "equals": "Refund: 15 Wood" },
    { "screenshot": "silo-detail" }
  ]
}
