{
  "$schema": "../scenario.schema.json",
  "name": "build-menu",
  "description": "B opens the build menu: discovered buildings first (color when affordable, gray when not), then undiscovered ones (a tier not yet unlocked by research); a hover shows the cost (none for undiscovered); a modal menu stops the world; clicking a discovered cell selects it for placement with the placement tooltip; B, Escape, and the close button close the menu.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Every tier 1 building is discovered from the start; 30 Wood and 5 Stone afford the Lumber Camp, the Silo, and the Small Hub but leave the Mine short.", "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Stone", "amount": 15 } },
    { "seedStockpile": { "type": "Stone", "amount": -10 } },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildMenu" },
    { "expect": "ui.cells", "equals": [
      { "type": "Road", "state": "affordable", "label": "Road" },
      { "type": "Bridge", "state": "affordable", "label": "Bridge" },
      { "type": "BurnerGenerator", "state": "unaffordable", "label": "Burner Generator" },
      { "type": "CementKiln", "state": "unaffordable", "label": "Cement Kiln" },
      { "type": "CharcoalKiln", "state": "unaffordable", "label": "Charcoal Kiln" },
      { "type": "Depot", "state": "unaffordable", "label": "Depot" },
      { "type": "Glassworks", "state": "unaffordable", "label": "Glassworks" },
      { "type": "LumberCamp", "state": "affordable", "label": "Lumber Camp" },
      { "type": "Mine", "state": "unaffordable", "label": "Mine" },
      { "type": "Relay", "state": "unaffordable", "label": "Relay" },
      { "type": "ResearchLab", "state": "unaffordable", "label": "Research Lab" },
      { "type": "SandCollector", "state": "unaffordable", "label": "Sand Collector" },
      { "type": "Sawmill", "state": "unaffordable", "label": "Sawmill" },
      { "type": "Silo", "state": "affordable", "label": "Silo" },
      { "type": "SmallHub", "state": "affordable", "label": "Small Hub" },
      { "type": "Smelter", "state": "unaffordable", "label": "Smelter" },
      { "type": "Stockyard", "state": "unaffordable", "label": "Stockyard" },
      { "type": "Warehouse", "state": "unaffordable", "label": "Warehouse" },
      { "type": "WaterPump", "state": "unaffordable", "label": "Water Pump" },
      { "type": "WaterWheel", "state": "unaffordable", "label": "Water Wheel" },
      { "type": "AirSeparator", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "AluminumSmelter", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "AssemblyPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "BatteryBank", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "BrineWell", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ChemicalPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ConcreteMixer", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DeepMine", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DeepWell", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DrillRig", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ElectricFurnace", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Electrolyzer", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ElectronicsWorks", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "EnrichmentPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Fabricator", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "FissionReactor", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Forester", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "FuelPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "LumberMill", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "OilWell", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "PumpingStation", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Quarry", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Refinery", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "RockCrusher", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SandDredge", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SemiconductorFab", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Shipyard", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SolarArray", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SteelMill", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "TankFarm", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "TileKiln", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Vault", "state": "undiscovered", "label": "Undiscovered" }
    ] },

    { "comment": "The modal menu takes all input: a right click on the world behind it walks nowhere.", "aimAt": { "world": [40.5, 32.5] } },
    { "click": { "button": "right" } },
    { "wait": 10 },
    { "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 32 },

    { "hoverUi": { "id": "buildMenu/Mine" } },
    { "wait": 15 },
    { "comment": "What it does first, then its cost.", "expect": "ui.tooltip", "equals": ["Digs Iron Ore, Copper Ore, Coal, Stone, and", "other ore deposits nearby.", "25 Wood", "15 Stone (have 5)"] },
    { "screenshot": "menu-hover" },
    { "hoverUi": { "id": "buildMenu/AluminumSmelter" } },
    { "wait": 15 },
    { "comment": "An undiscovered building keeps its cost a mystery.", "expect": "ui.tooltip", "equals": null },
    { "clickUi": { "id": "buildMenu/AluminumSmelter" } },
    { "wait": 1 },
    { "comment": "Clicking an undiscovered cell does nothing.", "expect": "ui.open", "equals": "buildMenu" },

    { "press": "B" },
    { "wait": 1 },
    { "comment": "B toggles the menu closed.", "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/close" } },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "comment": "An unaffordable but discovered building can be selected and positioned.", "expect": "ui.open", "equals": null },
    { "expect": "build.selected", "equals": "Mine" },
    { "aimAt": { "world": [29, 29] } },
    { "wait": 2 },
    { "expect": "build.ghost.affordable", "equals": false },
    { "expect": "build.tooltip[0]", "equals": "Mine" },
    { "expect": "build.tooltip[2]", "equals": "15 Stone (have 5)" },
    { "screenshot": "placing" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "build", "equals": null }
  ]
}
