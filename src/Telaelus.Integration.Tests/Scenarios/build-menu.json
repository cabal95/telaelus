{
  "$schema": "../scenario.schema.json",
  "name": "build-menu",
  "description": "B opens the build menu on a tier picker over Tier 1: Road, Bridge, and the buildings by name (color when affordable, gray when not); a locked tier is a disabled cell naming its research; a hover shows the cost; a modal menu stops the world; clicking a discovered cell selects it for placement with the placement tooltip; B, Escape, and the close button close the menu; after Steel Works, Tier 2 shows its 20 buildings and the menu reopens on the tier last viewed.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Tier 1 is open from the start; 30 Wood and 5 Stone afford the Lumber Camp, the Silo, the Small Hub, Road, and Bridge but leave the Mine short.", "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Stone", "amount": 15 } },
    { "seedStockpile": { "type": "Stone", "amount": -10 } },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildMenu" },
    { "expect": "ui.cells", "equals": [
      { "type": "Bridge", "state": "affordable", "label": "Bridge" },
      { "type": "BurnerGenerator", "state": "unaffordable", "label": "Burner Generator" },
      { "type": "CementKiln", "state": "unaffordable", "label": "Cement Kiln" },
      { "type": "CharcoalKiln", "state": "unaffordable", "label": "Charcoal Kiln" },
      { "type": "Depot", "state": "unaffordable", "label": "Depot" },
      { "type": "Glassworks", "state": "unaffordable", "label": "Glassworks" },
      { "type": "LumberCamp", "state": "affordable", "label": "Lumber Camp" },
      { "type": "Mine", "state": "unaffordable", "label": "Mine" },
      { "type": "Relay", "state": "unaffordable", "label": "Relay" },
      { "type": "ResearchLab", "state": "unaffordable", "label": "Research Lab" },
      { "type": "Road", "state": "affordable", "label": "Road" },
      { "type": "SandCollector", "state": "unaffordable", "label": "Sand Collector" },
      { "type": "Sawmill", "state": "unaffordable", "label": "Sawmill" },
      { "type": "Silo", "state": "affordable", "label": "Silo" },
      { "type": "SmallHub", "state": "affordable", "label": "Small Hub" },
      { "type": "Smelter", "state": "unaffordable", "label": "Smelter" },
      { "type": "Stockyard", "state": "unaffordable", "label": "Stockyard" },
      { "type": "Warehouse", "state": "unaffordable", "label": "Warehouse" },
      { "type": "WaterPump", "state": "unaffordable", "label": "Water Pump" },
      { "type": "WaterWheel", "state": "unaffordable", "label": "Water Wheel" }
    ] },

    { "comment": "The modal menu takes all input: a right click on the world behind it walks nowhere.", "aimAt": { "world": [40.5, 32.5] } },
    { "click": { "button": "right" } },
    { "wait": 10 },
    { "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 32 },

    { "hoverUi": { "id": "buildMenu/Mine" } },
    { "wait": 15 },
    { "comment": "What it does first, then its cost.", "expect": "ui.tooltip", "equals": ["Digs Iron Ore, Copper Ore, Coal, Stone, and", "other ore deposits nearby.", "25 Wood", "15 Stone (have 5)"] },
    { "screenshot": "menu-hover" },
    { "comment": "A locked tier's cell names the research that unlocks it.", "hoverUi": { "id": "buildMenu/tier/Tier 2" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["Unlocked by Steel Works research"] },
    { "screenshot": "menu-locked-tier" },
    { "clickUi": { "id": "buildMenu/tier/Tier 2" } },
    { "wait": 1 },
    { "comment": "Clicking it does nothing.", "expect": "ui.tier", "equals": 1 },
    { "expect": "ui.open", "equals": "buildMenu" },

    { "press": "B" },
    { "wait": 1 },
    { "comment": "B toggles the menu closed.", "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/close" } },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "comment": "An unaffordable but discovered building can be selected and positioned.", "expect": "ui.open", "equals": null },
    { "expect": "build.selected", "equals": "Mine" },
    { "aimAt": { "world": [29, 29] } },
    { "wait": 2 },
    { "expect": "build.ghost.affordable", "equals": false },
    { "expect": "build.tooltip[0]", "equals": "Mine" },
    { "expect": "build.tooltip[2]", "equals": "15 Stone (have 5)" },
    { "screenshot": "placing" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "build", "equals": null },

    { "comment": "Steel Works opens Tier 2; the menu stays on the tier last viewed.", "setResearchProgress": { "project": "SteelWorks", "seconds": 1200 } },
    { "press": "B" },
    { "wait": 2 },
    { "expect": "ui.tier", "equals": 1 },
    { "expect": "ui.tiers[1]", "equals": { "label": "Tier 2", "enabled": true, "checked": false } },
    { "clickUi": { "id": "buildMenu/tier/Tier 2" } },
    { "wait": 2 },
    { "expect": "ui.tier", "equals": 2 },
    { "expect": "ui.cells[0]", "equals": { "type": "AluminumSmelter", "state": "unaffordable", "label": "Aluminum Smelter" } },
    { "expect": "ui.cells[19]", "exists": true },
    { "expect": "ui.cells[20]", "exists": false },
    { "screenshot": "menu-tier2" },
    { "press": "B" },
    { "wait": 1 },
    { "press": "B" },
    { "wait": 2 },
    { "comment": "Reopened, it is still on Tier 2.", "expect": "ui.tier", "equals": 2 }
  ]
}
