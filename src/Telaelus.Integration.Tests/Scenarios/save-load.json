{
  "$schema": "../scenario.schema.json",
  "name": "save-load",
  "description": "Saving and loading: Escape opens the game menu and stands the game still; Save Game saves under a name; Load Game asks first with unsaved progress and brings the saved game back; leaving for the main menu asks first, and the menu then offers Continue and Load Game.",
  "steps": [
    { "comment": "A run's saves live in its own folder, so the menu starts with none.", "expect": "ui.menu.buttons", "equals": ["New Game", "Demo", "Quit"] },
    { "newGame": {} },
    { "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "expect": "ui.unsaved", "equals": false },
    { "wait": 60 },
    { "expect": "ui.unsaved", "equals": true },

    { "press": "Escape" },
    { "expect": "ui.open", "equals": "gameMenu" },
    { "expect": "ui.buttons", "equals": ["Resume", "Save Game", "Load Game", "Trainer", "Main Menu", "Quit"] },
    { "screenshot": "game-menu" },
    { "comment": "The game stands still while the menu is open.", "wait": 30 },
    { "expect": "ui.playTime", "equals": 2 },

    { "clickUi": { "id": "gameMenu/SaveGame" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "saveGame" },
    { "expect": "ui.name", "equals": "Save 1" },
    { "screenshot": "save-dialog" },
    { "clickUi": { "id": "saveGame/Save" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "gameMenu" },
    { "expect": "ui.status", "equals": "Saved as Save 1" },
    { "expect": "ui.unsaved", "equals": false },
    { "press": "Escape" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },

    { "comment": "Change the game, then load the save back.", "seedStockpile": { "type": "Wood", "amount": 99 } },
    { "wait": 60 },
    { "press": "Escape" },
    { "wait": 2 },
    { "clickUi": { "id": "gameMenu/LoadGame" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "loadGame" },
    { "expect": "ui.saves", "equals": [{ "name": "Save 1", "loadable": true, "outdated": false }] },
    { "screenshot": "load-dialog" },
    { "clickUi": { "id": "loadGame/Load" } },
    { "wait": 2 },
    { "expect": "ui.confirm", "equals": "Unsaved progress will be lost." },
    { "clickUi": { "id": "loadGame/Confirm" } },
    { "wait": 8 },
    { "expect": "app", "equals": "game" },
    { "expect": "ui.open", "equals": null },
    { "expect": "stockpile.Wood", "equals": 30 },
    { "expect": "ui.unsaved", "equals": false },

    { "comment": "The saveGame and loadGame commands do the same without the dialogs.", "saveGame": { "name": "Second" } },
    { "seedStockpile": { "type": "Wood", "amount": 5 } },
    { "loadGame": { "name": "Second" } },
    { "expect": "app", "equals": "game" },
    { "expect": "stockpile.Wood", "equals": 30 },

    { "wait": 60 },
    { "press": "Escape" },
    { "wait": 2 },
    { "clickUi": { "id": "gameMenu/MainMenu" } },
    { "wait": 2 },
    { "expect": "ui.confirm", "equals": "Unsaved progress will be lost." },
    { "clickUi": { "id": "gameMenu/Confirm" } },
    { "wait": 2 },
    { "expect": "app", "equals": "menu" },
    { "expect": "ui.menu.buttons", "equals": ["Continue", "New Game", "Load Game", "Demo", "Quit"] },
    { "screenshot": "menu-with-saves" }
  ]
}
