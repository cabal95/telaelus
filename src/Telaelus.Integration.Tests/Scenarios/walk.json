{
  "$schema": "../scenario.schema.json",
  "name": "walk",
  "description": "Walking by mouse: a right click (or Ctrl + left) on the ground walks there, with a ring where the walk ends; a left click on ground does not walk; a right click with a panel open walks and keeps it open; a right click on a building walks beside it, and on water to the nearest shore; a right drag pans without walking; in build mode a left click places and a right click walks.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "expect": "player.walking", "equals": false },

    { "aimAt": { "world": [40.5, 32.5] } },
    { "click": { "button": "right" } },
    { "wait": 2 },
    { "expect": "player.walking", "equals": true },
    { "expect": "player.destination", "equals": [40.5, 32.5] },
    { "screenshot": "walking" },
    { "wait": 60 },
    { "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 40.5 },
    { "expect": "player.position[1]", "approx": 32.5 },

    { "comment": "Ctrl + left walks the same.", "aimAt": { "world": [36.5, 32.5] } },
    { "click": { "ctrl": true } },
    { "wait": 2 },
    { "expect": "player.walking", "equals": true },
    { "wait": 45 },
    { "expect": "player.position[0]", "approx": 36.5 },

    { "comment": "A plain left click on ground does not walk.", "aimAt": { "world": [30.5, 32.5] } },
    { "click": {} },
    { "wait": 5 },
    { "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 36.5 },

    { "comment": "A left click on a building opens its panel; a right click on ground then walks and keeps it open.", "placeBuilding": { "type": "Smelter", "anchor": [44, 29] } },
    { "aimAt": { "world": [45.5, 30.5] } },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "player.walking", "equals": false },
    { "aimAt": { "world": [36.5, 28.5] } },
    { "click": { "button": "right" } },
    { "wait": 2 },
    { "expect": "player.walking", "equals": true },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "wait": 45 },
    { "press": "Escape" },
    { "wait": 1 },

    { "comment": "A right click on the Smelter walks to the ground beside it.", "aimAt": { "world": [45.5, 30.5] } },
    { "click": { "button": "right" } },
    { "wait": 2 },
    { "expect": "player.destination", "equals": [43.5, 30.5] },
    { "wait": 60 },
    { "expect": "player.position[0]", "approx": 43.5 },

    { "comment": "A pond at map cells (9, 5) and (10, 5): fine x 36 to 43, z 20 to 23.", "changeTiles": { "type": "ShallowWater", "cells": [[9, 5], [10, 5]] } },
    { "comment": "A right click on the pond walks to the nearest ground beside it: its south shore, one cell from the click.", "aimAt": { "world": [38.5, 23.5] } },
    { "click": { "button": "right" } },
    { "wait": 2 },
    { "expect": "player.destination", "equals": [38.5, 24.5] },
    { "wait": 60 },
    { "expect": "player.walking", "equals": false },
    { "expect": "player.position[0]", "approx": 38.5 },
    { "expect": "player.position[1]", "approx": 24.5 },
    { "screenshot": "shore" },

    { "comment": "A right drag pans the camera and does not walk.", "drag": { "button": "right", "from": [640, 400], "to": [440, 400] } },
    { "expect": "camera.detached", "equals": true },
    { "expect": "player.walking", "equals": false },
    { "press": "Space" },
    { "wait": 12 },

    { "comment": "In build mode a left click places and a right click walks.", "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Stone", "amount": 30 } },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/SmallHub" } },
    { "wait": 1 },
    { "aimAt": { "world": [34.5, 26.5] } },
    { "click": {} },
    { "wait": 2 },
    { "expect": "player.walking", "equals": false },
    { "expect": "buildings[2].type", "equals": "SmallHub" },
    { "aimAt": { "world": [34.5, 28.5] } },
    { "click": { "button": "right" } },
    { "wait": 2 },
    { "expect": "player.walking", "equals": true },
    { "expect": "build.selected", "equals": "SmallHub" },
    { "expect": "buildings[3]", "exists": false }
  ]
}
