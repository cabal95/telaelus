{
  "$schema": "../scenario.schema.json",
  "name": "trucks",
  "description": "Depot trucks: a new Depot, online beside the HQ, comes with one truck; its panel shows a bay per truck slot and buys a second, sells it for half its cost back, and buys it again; a Mine linked to the network by Small Hubs, with 12 Iron Ore in its buffer, gets a truck, which loads it, carries it to the HQ, backs onto the HQ's pad, unloads it into storage there, and parks; the collector's status strip shows the truck on its way; hovering a parked truck names its state.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Beside the HQ, so it is online. It faces North: its bays are on the apron at z 14..15.", "placeBuilding": { "type": "Depot", "anchor": [46, 14] } },
    { "comment": "The player steps off the spawn point, where the 4 x 4 Mine stands.", "teleportPlayer": { "x": 40, "z": 24 } },
    { "placeBuilding": { "type": "Mine", "anchor": [30, 30] } },
    { "comment": "Small Hubs from the HQ put the Mine online (trucks serve only online collectors).", "placeBuilding": { "type": "SmallHub", "anchor": [52, 22] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [44, 32] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [36, 34] } },
    { "wait": 2 },
    { "expect": "trucks[0].state", "equals": "parked" },
    { "expect": "trucks[0].depot", "equals": 2 },
    { "expect": "trucks[1]", "exists": false },
    { "expect": "buildings[1].online", "equals": true },

    { "aimAt": { "world": [48, 17.5] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "A bay per truck slot: the one it came with parked, three empty.", "expect": "ui.trucks", "equals": [{ "state": "parked", "tip": "Truck 1: Parked" }, { "state": "empty", "tip": "Empty bay" }, { "state": "empty", "tip": "Empty bay" }, { "state": "empty", "tip": "Empty bay" }] },
    { "expect": "ui.buyTruck", "equals": { "text": "Buy truck", "enabled": false, "tip": "Costs 15 Iron, 10 Wood" } },
    { "seedStockpile": { "type": "Iron", "amount": 15 } },
    { "seedStockpile": { "type": "Wood", "amount": 10 } },
    { "wait": 2 },
    { "expect": "ui.buyTruck.enabled", "equals": true },
    { "clickUi": { "id": "buildingDetail/buyTruck" } },
    { "wait": 2 },
    { "expect": "ui.trucks[1]", "equals": { "state": "parked", "tip": "Truck 2: Parked" } },
    { "expect": "ui.trucks[2].state", "equals": "empty" },
    { "expect": "stockpile.Iron", "equals": 0 },
    { "screenshot": "depot-panel" },
    { "comment": "Selling the bought truck gives half its cost back.", "expect": "ui.sellTruck", "equals": { "text": "Sell truck", "enabled": true, "tip": "Gives back 8 Iron, 5 Wood" } },
    { "clickUi": { "id": "buildingDetail/sellTruck" } },
    { "wait": 2 },
    { "expect": "ui.trucks[1].state", "equals": "empty" },
    { "expect": "stockpile.Iron", "equals": 8 },
    { "expect": "stockpile.Wood", "equals": 5 },
    { "comment": "The one the Depot came with sells for nothing.", "expect": "ui.sellTruck", "equals": { "text": "Sell truck", "enabled": true, "tip": "Gives nothing back (the truck the Depot came with)" } },
    { "seedStockpile": { "type": "Iron", "amount": 7 } },
    { "seedStockpile": { "type": "Wood", "amount": 5 } },
    { "wait": 2 },
    { "clickUi": { "id": "buildingDetail/buyTruck" } },
    { "wait": 2 },
    { "expect": "ui.trucks[1].state", "equals": "parked" },
    { "press": "Escape" },
    { "wait": 2 },

    { "comment": "Hovering the parked second truck (bay 1, at x 47.5, z 15) names it.", "aimAt": { "world": [47.5, 15] } },
    { "wait": 2 },
    { "expect": "ui.worldTip", "equals": ["Truck", "Parked"] },

    { "fillBuffer": { "anchor": [30, 30], "type": "IronOre", "amount": 12 } },
    { "wait": 2 },
    { "comment": "Trucks serve only online collectors.", "expect": "buildings[2].online", "equals": true },
    { "expect": "trucks[0].state", "equals": "toCollector" },
    { "expect": "trucks[0].target", "equals": 3 },
    { "expect": "trucks[1].state", "equals": "parked" },
    { "aimAt": { "world": [31, 31] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "comment": "The collector's strip shows its truck on the way.", "expect": "ui.strip[2]", "equals": { "id": "truck", "value": null, "tone": "normal", "tip": "On its way" } },
    { "press": "Escape" },

    { "comment": "About 7 s to the Mine and 3 s loading 12 units: on its way to the HQ with the load.", "wait": 330 },
    { "expect": "trucks[0].state", "equals": "toHq" },
    { "expect": "trucks[0].cargo", "equals": "IronOre" },
    { "expect": "trucks[0].amount", "equals": 12 },
    { "expect": "buildings[2].output", "equals": {} },
    { "wait": 15 },
    { "screenshot": "loaded" },

    { "comment": "About 10 s round to the front of the HQ's pad, then it backs on, its bed to the entrance.", "wait": 355 },
    { "expect": "trucks[0].state", "equals": "unloading" },
    { "expect": "trucks[0].position", "equals": [59, 10.6] },
    { "aimAt": { "world": [59, 10.6] } },
    { "wait": 2 },
    { "expect": "ui.worldTip", "equals": ["Truck", "Unloading"] },
    { "screenshot": "on-pad" },
    { "comment": "3 s unloading 12 units, then it drives off the pad and home.", "wait": 120 },
    { "expect": "stockpile.IronOre", "equals": 12 },
    { "wait": 150 },
    { "expect": "trucks[0].state", "equals": "parked" },
    { "expect": "trucks[0].cargo", "equals": null }
  ]
}
