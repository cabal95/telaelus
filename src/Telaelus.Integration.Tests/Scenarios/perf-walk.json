{
  "$schema": "../scenario.schema.json",
  "name": "perf-walk",
  "description": "The standing performance benchmark: a fixed generated world (seed 2) at the widest zoom, walking a set path (nine right clicks from the spawn at (130, 130)) for about 30 seconds across grassland and forest. Run it windowed and read the perf summary in report.json; in the headless suite it is a smoke test of a long walk across chunks, with no timing checks.",
  "steps": [
    { "newGame": {} },
    { "initMap": { "generate": 2 } },
    { "cameraZoom": { "size": 40 } },
    { "wait": 30 },
    { "screenshot": "start" },
    { "comment": "Screen right (world +x, -z), in three clicks of about 20 units.", "aimAt": { "world": [144, 116] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [158, 102] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [172, 88] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "comment": "Screen down (world +x, +z).", "aimAt": { "world": [186, 102] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [200, 116] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [214, 130] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "comment": "Screen left (world -x, +z).", "aimAt": { "world": [200, 144] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [186, 158] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "aimAt": { "world": [172, 172] } },
    { "click": { "button": "right" } },
    { "wait": 100 },
    { "screenshot": "end" },
    { "comment": "The walk went the whole way, round whatever was in it.", "expect": "player.position[0]", "approx": 172, "tolerance": 6 },
    { "expect": "player.position[1]", "approx": 172, "tolerance": 6 },
    { "expect": "world.kind", "equals": "Generated" }
  ]
}
