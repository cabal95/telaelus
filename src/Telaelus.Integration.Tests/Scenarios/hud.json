{
  "$schema": "../scenario.schema.json",
  "name": "hud",
  "description": "The screen UI: the debug overlay starts hidden and F3 toggles it; the top bar shows the six starting deposits with name tooltips, and no Power, Water, Sand, or ship bill with none on the network; the hint overlay shows the harvest hint and its bar; I opens and closes the inventory on its Resources choice, discovered resources first; the inventory and a building's detail panel replace each other; a panel covers the debug overlay.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "wait": 2 },
    { "comment": "Debug data is off by default.", "expect": "ui.debug", "equals": false },
    { "press": "F3" },
    { "wait": 1 },
    { "expect": "ui.debug", "equals": true },
    { "press": "F3" },
    { "wait": 1 },
    { "expect": "ui.debug", "equals": false },

    { "comment": "The empty map discovers nothing, so the bar starts with no pins.", "expect": "ui.topBar.items", "equals": [] },
    { "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Iron", "amount": 12 } },
    { "comment": "A Crude Oil seep discovers Crude Oil with no storage for it yet.", "placeResource": { "type": "CrudeOil", "mapCell": [2, 2] } },
    { "wait": 1 },
    { "expect": "ui.topBar.items[0]", "equals": { "type": "Wood", "amount": 30, "limit": 100, "full": false, "text": "30", "tone": "normal" } },
    { "comment": "Each discovery pinned itself, in table order; Crude Oil, with no storage for it yet, shows dim, not full.", "expect": "ui.topBar.items[1]", "equals": { "type": "CrudeOil", "amount": 0, "limit": 0, "full": true, "text": "0", "tone": "dim" } },
    { "expect": "ui.topBar.items[2]", "equals": { "type": "Iron", "amount": 12, "limit": null, "full": false, "text": "12", "tone": "normal" } },
    { "expect": "ui.topBar.items[3]", "exists": false },
    { "comment": "Power, Water, and Sand stay off the bar while the network has none of them, and the ship bill is the Shipyard's.", "expect": "ui.topBar.power", "equals": null },
    { "expect": "ui.topBar.water", "equals": null },
    { "expect": "ui.topBar.sand", "equals": null },
    { "expect": "ui.topBar.launch", "exists": false },
    { "comment": "The bar rebuilt as the pins changed; let it lay out before hovering.", "wait": 2 },
    { "hoverUi": { "id": "topBar/Wood" } },
    { "wait": 15 },
    { "comment": "The tooltip names it with its amount and limit.", "expect": "ui.tooltip", "equals": ["Wood 30 / 100"] },
    { "screenshot": "top-bar" },

    { "comment": "Map cell (8, 7) spans z 28..32; the player stands 1 unit past its edge.", "placeResource": { "type": "Wood", "mapCell": [8, 7] } },
    { "teleportPlayer": { "x": 33.5, "z": 33 } },
    { "wait": 2 },
    { "expect": "ui.hint.text", "equals": "[E] Harvest Wood" },
    { "keyDown": "E" },
    { "wait": 45 },
    { "expect": "ui.hint.progress", "gte": 0.4 },
    { "screenshot": "hint" },
    { "keyUp": "E" },
    { "teleportPlayer": { "x": 40, "z": 30 } },
    { "wait": 2 },
    { "expect": "ui.hint", "equals": null },

    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "inventory" },
    { "comment": "It opens on the raw resources.", "expect": "ui.inventoryChoice", "equals": "Resources" },
    { "expect": "ui.inventory[0]", "equals": { "type": "Wood", "name": "Wood (30 / 100)", "amount": 30, "limit": 100, "section": "raw", "discovered": true, "pinned": true } },
    { "comment": "Undiscovered raw resources follow the discovered ones, named; Lithium is the last raw row.", "expect": "ui.inventory[16]", "equals": { "type": "Lithium", "name": "Lithium", "amount": 0, "limit": 0, "section": "raw", "discovered": false, "pinned": false } },
    { "expect": "ui.inventory[17]", "exists": false },
    { "comment": "12 Iron take 12 of the HQ's 150 Cargo.", "expect": "ui.cargo", "equals": "Cargo (12 / 150)" },
    { "press": "F3" },
    { "wait": 2 },
    { "comment": "The debug overlay shows, and the open panel may cover it.", "expect": "ui.debug", "equals": true },
    { "screenshot": "inventory" },
    { "press": "F3" },
    { "press": "I" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "comment": "One panel at a time: the inventory and a building's detail replace each other.", "placeBuilding": { "type": "LumberCamp", "anchor": [44, 36] } },
    { "press": "I" },
    { "wait": 1 },
    { "aimAt": { "world": [45, 37] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "press": "I" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "inventory" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null }
  ]
}
