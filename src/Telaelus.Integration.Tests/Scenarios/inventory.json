{
  "$schema": "../scenario.schema.json",
  "name": "inventory",
  "description": "The inventory shows one choice at a time under an arrow picker: it opens on Resources, every raw resource named and grayed until discovered (a tooltip says it is not yet found); a field in sight and a held resource are discovered, pinned, and move to the top; the right arrow steps to Tier 1 and stops there while Tier 2 is locked; the panel reopens on the last choice; after Steel Works the arrow reaches Tier 2.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "wait": 2 },
    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "inventory" },
    { "expect": "discovered", "equals": [] },
    { "expect": "ui.inventoryChoice", "equals": "Resources" },
    { "expect": "ui.inventoryArrows", "equals": { "prev": false, "next": true } },
    { "expect": "ui.inventory[0]", "equals": { "type": "Wood", "name": "Wood", "amount": 0, "limit": 100, "section": "raw", "discovered": false, "pinned": false } },
    { "expect": "ui.inventory[16].type", "equals": "Lithium" },
    { "expect": "ui.inventory[17]", "exists": false },
    { "hoverUi": { "id": "inventory/Coal" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["Not yet found"] },
    { "screenshot": "nothing-discovered" },

    { "comment": "A Quartz field in an explored cell discovers Quartz, which moves to the top of the raw rows.", "placeResource": { "type": "Quartz", "mapCell": [6, 6] } },
    { "seedStockpile": { "type": "Copper", "amount": 3 } },
    { "wait": 2 },
    { "expect": "discovered", "equals": ["Quartz", "Copper"] },
    { "expect": "ui.inventory[0]", "equals": { "type": "Quartz", "name": "Quartz (0 / 0)", "amount": 0, "limit": 0, "section": "raw", "discovered": true, "pinned": true } },
    { "expect": "ui.inventory[1]", "equals": { "type": "Wood", "name": "Wood", "amount": 0, "limit": 100, "section": "raw", "discovered": false, "pinned": false } },

    { "comment": "The right arrow steps to Tier 1; Tier 2 is locked, so it stops there.", "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 1" },
    { "expect": "ui.inventoryArrows", "equals": { "prev": true, "next": false } },
    { "expect": "ui.inventory[0]", "equals": { "type": "Copper", "name": "Copper (3)", "amount": 3, "limit": null, "section": "tier1", "discovered": true, "pinned": true } },
    { "expect": "ui.inventory[1]", "equals": { "type": "Iron", "name": "Iron", "amount": 0, "limit": null, "section": "tier1", "discovered": false, "pinned": false } },
    { "expect": "ui.inventory[6]", "exists": false },
    { "hoverUi": { "id": "inventory/Iron" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["Not yet made"] },
    { "screenshot": "tier-1" },

    { "comment": "Closed and reopened, it is still on Tier 1.", "press": "I" },
    { "wait": 2 },
    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 1" },

    { "comment": "Steel Works unlocks Tier 2, and the right arrow reaches it.", "setResearchProgress": { "project": "SteelWorks", "seconds": 1200 } },
    { "wait": 2 },
    { "expect": "ui.inventoryArrows", "equals": { "prev": true, "next": true } },
    { "clickUi": { "id": "inventory/tier/next" } },
    { "wait": 2 },
    { "expect": "ui.inventoryChoice", "equals": "Tier 2" },
    { "expect": "ui.inventory[0].section", "equals": "tier2" },
    { "expect": "ui.inventory[12].type", "equals": "CarbonFiber" },
    { "expect": "ui.inventory[13]", "exists": false },
    { "expect": "ui.inventoryArrows", "equals": { "prev": true, "next": false } },
    { "screenshot": "tier-2" }
  ]
}
