{
  "$schema": "../scenario.schema.json",
  "name": "capacity",
  "description": "Sand as capacity on the HQ network: a Glassworks with no Sand is in a blackout (danger on the top bar's Sand pin); a Sand Collector on Sand terrain supplies it and Glass is made; five Glassworks on four Collectors push Sand into a brownout at half speed (warning on the pin, and the Glassworks panel's Sand row).",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Sand south-west of the HQ (fine cells x 48..55, z 16..19), in its coverage.", "changeTiles": { "type": "Sand", "biome": "Desert", "cells": [[12, 4], [13, 4]] } },
    { "seedStockpile": { "type": "Coal", "amount": 50 } },
    { "teleportPlayer": { "x": 40, "z": 24 } },

    { "placeBuilding": { "type": "Glassworks", "anchor": [44, 10] } },
    { "wait": 2 },
    { "expect": "buildings[1].online", "equals": true },
    { "expect": "buildings[1].idleReason", "equals": "Blackout: Sand" },
    { "comment": "The default pins end with Sand and Water.", "expect": "ui.topBar.items[6].type", "equals": "Sand" },
    { "expect": "ui.topBar.items[6].text", "equals": "Blackout: 2 / 0" },
    { "expect": "ui.topBar.items[6].tone", "equals": "danger" },
    { "screenshot": "no-sand" },

    { "placeBuilding": { "type": "SandCollector", "anchor": [52, 16] } },
    { "wait": 2 },
    { "expect": "capacity.sand", "equals": { "supply": 2, "demand": 2, "speed": 1, "state": "normal" } },
    { "expect": "ui.topBar.items[6].text", "equals": "2 / 2" },
    { "expect": "ui.topBar.items[6].tone", "equals": "normal" },
    { "comment": "A 12 s cycle at 30 frames a second.", "wait": 380 },
    { "expect": "stockpile.Glass", "equals": 1 },
    { "expect": "stockpile.Sand", "equals": 0 },

    { "comment": "Four Collectors (8) under five Glassworks (10): a quarter over, a brownout at half speed. Two Small Hubs bring the west ones online.", "placeBuilding": { "type": "SandCollector", "anchor": [48, 16] } },
    { "placeBuilding": { "type": "SandCollector", "anchor": [50, 16] } },
    { "placeBuilding": { "type": "SandCollector", "anchor": [54, 16] } },
    { "placeBuilding": { "type": "Glassworks", "anchor": [41, 10] } },
    { "placeBuilding": { "type": "Glassworks", "anchor": [38, 10] } },
    { "placeBuilding": { "type": "Glassworks", "anchor": [35, 10] } },
    { "placeBuilding": { "type": "Glassworks", "anchor": [32, 10] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [47, 9] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [38, 8] } },
    { "wait": 2 },
    { "expect": "capacity.sand.state", "equals": "brownout" },
    { "expect": "capacity.sand.speed", "approx": 0.5 },
    { "expect": "ui.topBar.items[6].text", "equals": "10 / 8" },
    { "expect": "ui.topBar.items[6].tone", "equals": "warning" },
    { "screenshot": "brownout" },

    { "aimAt": { "world": [45.5, 13] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.rows.sand", "equals": "Draws 2 (running at 50%)" },
    { "expect": "ui.rows.recipe", "equals": "1 Glass, 12 s" },
    { "screenshot": "glassworks-detail" }
  ]
}
