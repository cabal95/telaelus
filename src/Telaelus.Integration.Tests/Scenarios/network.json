{
  "$schema": "../scenario.schema.json",
  "name": "network",
  "description": "The HQ network: a Mine out of the HQ's reach is offline, shows the warning marker, and makes nothing; the player can still collect what its buffer holds by hand; N shows the network overlay; one Small Hub in the HQ's link range brings the Mine online; the placement tooltip says whether a spot is online; a selected hub shows its coverage.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Iron Ore at map cell (5, 8) is 1 unit from the Mine's center (25, 34); the HQ is in the north-east corner.", "placeResource": { "type": "IronOre", "mapCell": [5, 8] } },
    { "placeBuilding": { "type": "Mine", "anchor": [24, 33] } },
    { "comment": "About 9 seconds, past the 8 s one Iron Ore takes: offline, the Mine makes nothing.", "wait": 270 },
    { "expect": "buildings[1].online", "equals": false },
    { "expect": "buildings[1].output.IronOre", "exists": false },
    { "expect": "buildings[1].status", "equals": "idle" },
    { "comment": "What it held from before stays collectable.", "fillBuffer": { "anchor": [24, 33], "type": "IronOre", "amount": 1 } },
    { "expect": "stockpile.IronOre", "equals": 0 },
    { "expect": "ui.network.offlineMarkers", "equals": 1 },
    { "teleportPlayer": { "x": 32, "z": 26 } },
    { "wait": 2 },
    { "screenshot": "offline-mine" },

    { "comment": "Standing at the Mine, E collects the whole buffer in one 0.5 s hold.", "teleportPlayer": { "x": 25, "z": 34 } },
    { "wait": 2 },
    { "expect": "ui.hint.text", "equals": "[E] Collect Iron Ore (1)" },
    { "keyDown": "E" },
    { "wait": 25 },
    { "keyUp": "E" },
    { "expect": "stockpile.IronOre", "equals": 1 },
    { "expect": "buildings[1].output.IronOre", "exists": false },

    { "press": "N" },
    { "wait": 2 },
    { "expect": "ui.network.overlay", "equals": true },
    { "expect": "ui.network.shownHubs[0]", "exists": true },
    { "comment": "One Small Hub 34 units from the HQ's center (inside its 44 link) covers the Mine (8.3 away).", "placeBuilding": { "type": "SmallHub", "anchor": [33, 29] } },
    { "teleportPlayer": { "x": 32, "z": 26 } },
    { "wait": 2 },
    { "expect": "buildings[1].online", "equals": true },
    { "expect": "buildings[1].status", "equals": "working" },
    { "expect": "ui.network.offlineMarkers", "equals": 0 },
    { "expect": "ui.network.shownHubs[1]", "exists": true },
    { "screenshot": "overlay" },
    { "press": "N" },
    { "wait": 1 },

    { "seedStockpile": { "type": "Wood", "amount": 20 } },
    { "seedStockpile": { "type": "Stone", "amount": 10 } },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/SmallHub" } },
    { "wait": 1 },
    { "aimAt": { "world": [10, 56] } },
    { "wait": 2 },
    { "expect": "build.tooltip[3]", "equals": "Offline (no hub in reach)" },
    { "aimAt": { "world": [31, 38] } },
    { "wait": 2 },
    { "expect": "build.tooltip[3]", "equals": "Online" },
    { "screenshot": "placing-hub" },
    { "press": "Escape" },
    { "wait": 1 },

    { "comment": "Clicking the hub shows its coverage alone.", "aimAt": { "world": [33.5, 29.5] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "The strip shows the hub on and online.", "expect": "ui.strip[1]", "equals": { "id": "network", "value": null, "tone": "good", "tip": "Online: connected to the network" } },
    { "expect": "ui.rows.reach", "equals": "covers 11, links 22" },
    { "expect": "ui.network.shownHubs[0]", "exists": true },
    { "expect": "ui.network.shownHubs[1]", "exists": false },
    { "screenshot": "hub-detail" }
  ]
}
