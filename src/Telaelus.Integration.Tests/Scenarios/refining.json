{
  "$schema": "../scenario.schema.json",
  "name": "refining",
  "description": "Tier-1 refining beside the HQ: a Steel Mill's panel shows its Coal or Charcoal picker on Auto with a note naming what it uses and why; an Electrolyzer makes Hydrogen by default and its panel shows the Recipe picker; a Fuel Plant turns Kerosene and Hydrogen into Rocket Fuel; the top bar's launch progress lists Liquid Oxygen.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 180 } },
    { "seedStockpile": { "type": "Charcoal", "amount": 4 } },
    { "comment": "Power, Water, and a Tank Farm for the fluids.", "placeBuilding": { "type": "BurnerGenerator", "anchor": [52, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [48, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [40, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [36, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [32, 0] } },
    { "placeBuilding": { "type": "TankFarm", "anchor": [28, 0] } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[13, 4]] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [52, 14] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [54, 14] } },
    { "teleportPlayer": { "x": 40, "z": 20 } },

    { "placeBuilding": { "type": "SteelMill", "anchor": [48, 4] } },
    { "queueCraft": { "anchor": [48, 4], "recipe": 0, "count": 99 } },
    { "placeBuilding": { "type": "Electrolyzer", "anchor": [42, 4] } },
    { "seedStockpile": { "type": "Kerosene", "amount": 3 } },
    { "placeBuilding": { "type": "FuelPlant", "anchor": [42, 12] } },
    { "queueCraft": { "anchor": [42, 12], "recipe": 0, "count": 99 } },
    { "wait": 2 },
    { "expect": "buildings[10].recipe", "equals": "Steel" },
    { "expect": "buildings[10].idleReason", "equals": "Waiting for Iron, Limestone" },
    { "expect": "buildings[11].recipe", "equals": "Hydrogen" },
    { "expect": "ui.topBar.launch", "exists": false },

    { "aimAt": { "world": [50, 7] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.input", "equals": { "choice": "Auto", "note": "Auto: uses Coal (Coal 174, Charcoal 4)" } },
    { "expect": "ui.recipe", "equals": null },
    { "expect": "ui.rows.recipe", "equals": "2 Iron + 1 Coal or Charcoal + 1 Limestone to 1 Steel, 20 s" },
    { "screenshot": "steel-mill" },
    { "press": "Escape" },
    { "wait": 2 },

    { "comment": "Six seconds a unit of Hydrogen, then 8 s in the Fuel Plant with the Kerosene.", "wait": 600 },
    { "expect": "stockpile.RocketFuel", "equals": 1 },
    { "aimAt": { "world": [44, 6.5] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.recipe", "equals": "Hydrogen" },
    { "expect": "ui.rows.recipe", "equals": "1 Hydrogen, 6 s" },
    { "screenshot": "electrolyzer" }
  ]
}
