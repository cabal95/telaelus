{
  "$schema": "../scenario.schema.json",
  "name": "research",
  "description": "Research from a Research Lab: T opens the tree over most of the screen, cards on the left and the selected project's drawer on the right; a tier picker shows one tier at a time, Tier 2 disabled until Steel Works; starting Material Transfer from the drawer takes its fee; pausing keeps its progress, resuming charges nothing; once complete, an online Mine's Iron Ore flows into storage and once Steel Works unlocks tier 2, Tier 1 is checked and Tier 2's Advanced Material Transfer becomes available.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 60 } },
    { "seedStockpile": { "type": "Iron", "amount": 40 } },
    { "seedStockpile": { "type": "Copper", "amount": 20 } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "comment": "An online Mine on Iron Ore beside the HQ.", "placeResource": { "type": "IronOre", "mapCell": [12, 4], "amount": 200 } },
    { "placeBuilding": { "type": "Mine", "anchor": [52, 16] } },
    { "placeBuilding": { "type": "ResearchLab", "anchor": [48, 4] } },
    { "teleportPlayer": { "x": 36, "z": 24 } },
    { "wait": 2 },
    { "expect": "buildings[2].online", "equals": true },
    { "expect": "buildings[3].online", "equals": true },
    { "expect": "buildings[3].idleReason", "equals": "No research running" },

    { "press": "T" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "researchTree" },
    { "expect": "ui.header", "equals": "Speed 1x: 1 lab working" },
    { "comment": "It opens on the first project that can be worked on.", "expect": "ui.drawer.project", "equals": "MaterialTransfer" },
    { "expect": "ui.cards[0].selected", "equals": true },
    { "comment": "It shows Tier 1: Material Transfer and Steel Works; Tier 2 is locked behind Steel Works.", "expect": "ui.tier", "equals": 1 },
    { "expect": "ui.cards[1].shown", "equals": false },
    { "expect": "ui.cards[2].shown", "equals": true },
    { "expect": "ui.tiers[0]", "equals": { "label": "Tier 1", "enabled": true, "checked": false } },
    { "expect": "ui.tiers[1]", "equals": { "label": "Tier 2", "enabled": false, "checked": false } },
    { "expect": "ui.cards[1].locked", "equals": true },
    { "expect": "ui.drawer.state", "equals": "Available" },
    { "expect": "ui.drawer.button", "equals": "Start Research" },
    { "expect": "ui.drawer.enabled", "equals": true },
    { "expect": "ui.drawer.fee", "equals": "Fee: 40 Iron, 20 Copper" },
    { "expect": "ui.drawer.time", "equals": "2 days at 1 lab; 2 days left" },

    { "comment": "Selecting another card shows it in the drawer.", "clickUi": { "id": "researchTree/card/SteelWorks" } },
    { "wait": 2 },
    { "expect": "ui.drawer.project", "equals": "SteelWorks" },
    { "expect": "ui.drawer.state", "equals": "Available" },
    { "clickUi": { "id": "researchTree/card/MaterialTransfer" } },
    { "wait": 2 },
    { "clickUi": { "id": "researchTree/action" } },
    { "wait": 2 },
    { "expect": "research.active", "equals": "MaterialTransfer" },
    { "expect": "stockpile.Iron", "equals": 0 },
    { "expect": "stockpile.Copper", "equals": 0 },
    { "expect": "ui.cards[0].running", "equals": true },
    { "expect": "ui.drawer.button", "equals": "Pause Research" },
    { "expect": "ui.drawer.fee", "equals": "Fee paid" },
    { "wait": 300 },
    { "clickUi": { "id": "researchTree/action" } },
    { "wait": 2 },
    { "expect": "research.active", "equals": null },
    { "expect": "research.projects.materialTransfer.state", "equals": "paused" },
    { "expect": "research.projects.materialTransfer.progress", "approx": 10, "tolerance": 0.5 },
    { "expect": "ui.cards[0].running", "equals": false },
    { "expect": "ui.drawer.button", "equals": "Resume Research" },
    { "expect": "ui.drawer.progress", "approx": 0.008, "tolerance": 0.002 },
    { "wait": 60 },
    { "expect": "research.projects.materialTransfer.progress", "approx": 10, "tolerance": 0.5 },
    { "comment": "Resuming charges no second fee.", "clickUi": { "id": "researchTree/action" } },
    { "wait": 2 },
    { "expect": "research.active", "equals": "MaterialTransfer" },
    { "expect": "ui.drawer.state", "equals": "Running" },
    { "screenshot": "tree" },

    { "comment": "Near the end, then a few seconds to finish.", "setResearchProgress": { "project": "MaterialTransfer", "seconds": 1198 } },
    { "wait": 120 },
    { "expect": "research.projects.materialTransfer.state", "equals": "complete" },
    { "expect": "research.active", "equals": null },
    { "comment": "Advanced Material Transfer is tier 2: still locked until Steel Works opens the tier.", "expect": "ui.cards[1].locked", "equals": true },
    { "setResearchProgress": { "project": "SteelWorks", "seconds": 1200 } },
    { "wait": 2 },
    { "expect": "ui.cards[1].locked", "equals": false },
    { "comment": "Every Tier 1 project is complete: its cell has the check mark, and Tier 2 opens.", "expect": "ui.tiers[0]", "equals": { "label": "Tier 1", "enabled": true, "checked": true } },
    { "expect": "ui.tiers[1]", "equals": { "label": "Tier 2", "enabled": true, "checked": false } },
    { "clickUi": { "id": "researchTree/tier/Tier 2" } },
    { "wait": 2 },
    { "expect": "ui.tier", "equals": 2 },
    { "expect": "ui.cards[1].shown", "equals": true },
    { "comment": "Picking a tier selects its first project.", "expect": "ui.drawer.project", "equals": "AdvancedMaterialTransfer" },
    { "expect": "ui.drawer.state", "equals": "Available" },
    { "expect": "ui.drawer.button", "equals": "Start Research" },
    { "comment": "Its fee (60 Steel, 20 Glass) is not held.", "expect": "ui.drawer.enabled", "equals": false },
    { "screenshot": "complete" },
    { "press": "T" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "comment": "The Mine's Iron Ore now reaches storage on its own.", "expect": "stockpile.IronOre", "gte": 1 }
  ]
}
