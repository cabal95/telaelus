{
  "$schema": "../scenario.schema.json",
  "name": "roads",
  "description": "Roads and bridges by drag in build mode: the menu's Road tool lays an L of 2 x 2 tiles and takes their Stone; a Shift drag removes three for half back, and a right drag pans instead; across a strip of ShallowWater a Mine is out of a truck's reach until the Bridge tool spans it, and then the truck hauls its ore home over the bridge.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Stone", "amount": 200 } },
    { "seedStockpile": { "type": "Wood", "amount": 100 } },
    { "teleportPlayer": { "x": 35, "z": 24 } },
    { "wait": 2 },

    { "press": "B" },
    { "wait": 2 },
    { "comment": "Road and Bridge are tier 1 cells, sorted in by name: Bridge first.", "expect": "ui.cells[0].type", "equals": "Bridge" },
    { "expect": "ui.cells[10].type", "equals": "Road" },
    { "clickUi": { "id": "buildMenu/Road" } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "build.line", "equals": "Road" },
    { "comment": "An L from tile (30, 20) to (40, 26): six tiles along X, then three along Z, 4 Stone each on Grass.", "aimDrag": { "from": [30.5, 20.5], "to": [40.5, 26.5] } },
    { "wait": 2 },
    { "expect": "roads[8]", "exists": true },
    { "expect": "roads[9]", "exists": false },
    { "expect": "stockpile.Stone", "equals": 164 },
    { "comment": "A Shift drag over the first three tiles removes them, 6 Stone back.", "aimDrag": { "from": [30.5, 20.5], "to": [34.5, 20.5], "shift": true } },
    { "wait": 2 },
    { "expect": "roads[5]", "exists": true },
    { "expect": "roads[6]", "exists": false },
    { "expect": "stockpile.Stone", "equals": 170 },
    { "comment": "With the Road tool, a right drag pans the camera and lays or removes nothing.", "drag": { "button": "right", "from": [640, 400], "to": [440, 400] } },
    { "expect": "camera.detached", "equals": true },
    { "expect": "roads[5]", "exists": true },
    { "expect": "roads[6]", "exists": false },
    { "expect": "stockpile.Stone", "equals": 170 },
    { "press": "Space" },
    { "wait": 12 },
    { "screenshot": "road" },
    { "press": "Escape" },
    { "wait": 2 },
    { "expect": "build", "equals": null },

    { "comment": "A strip of ShallowWater down map column 5 (fine x 20..23); a Depot beside the HQ, a Mine across the water with ore waiting.", "changeTiles": { "type": "ShallowWater", "from": [5, 0], "to": [5, 15] } },
    { "placeBuilding": { "type": "Depot", "anchor": [46, 14] } },
    { "placeResource": { "type": "IronOre", "mapCell": [2, 10], "amount": 200 } },
    { "placeBuilding": { "type": "Mine", "anchor": [13, 40] } },
    { "fillBuffer": { "anchor": [13, 40], "type": "IronOre", "amount": 15 } },
    { "comment": "Two Relays and a Small Hub on the far bank put the Mine online (trucks serve only online collectors).", "placeBuilding": { "type": "Relay", "anchor": [36, 4] } },
    { "placeBuilding": { "type": "Relay", "anchor": [26, 24] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [16, 36] } },
    { "wait": 30 },
    { "comment": "No way across: the truck stays parked.", "expect": "trucks[0].state", "equals": "parked" },

    { "teleportPlayer": { "x": 26, "z": 38 } },
    { "press": "B" },
    { "wait": 2 },
    { "clickUi": { "id": "buildMenu/Bridge" } },
    { "wait": 2 },
    { "expect": "build.line", "equals": "Bridge" },
    { "comment": "Two tiles over the water, landing on grass at x 18 and x 24: 24 Wood and 8 Stone.", "aimDrag": { "from": [20.5, 40.5], "to": [22.5, 40.5] } },
    { "wait": 2 },
    { "expect": "bridges[0].alongX", "equals": true },
    { "expect": "stockpile.Wood", "equals": 76 },
    { "expect": "stockpile.Stone", "equals": 162 },
    { "press": "Escape" },
    { "wait": 2 },
    { "comment": "Now the truck finds its way across.", "wait": 60 },
    { "expect": "trucks[0].state", "equals": "toCollector" },
    { "screenshot": "bridge" },
    { "comment": "About 14 s out over the bridge, 4 s loading, 15 s back, and 4 s unloading.", "wait": 1500 },
    { "expect": "stockpile.IronOre", "gte": 15 }
  ]
}
