{
  "$schema": "../scenario.schema.json",
  "name": "field-detail",
  "description": "Clicking a resource field opens its detail panel: the resource's name, a full-field picture, Remaining and Worked by; the field keeps its outline while open; Mines working it show up; buildings and fields switch the panel; empty ground closes it; it closes when its field depletes.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Map cell (10, 9) spans x 40..44, z 36..40, centered at (42, 38).", "placeResource": { "type": "IronOre", "mapCell": [10, 9] } },
    { "comment": "A Forest Wood field to the east (clear of the panel on the left), for its conifer picture.", "changeTiles": { "cells": [[12, 9]], "biome": "Forest" } },
    { "placeResource": { "type": "Wood", "mapCell": [12, 9] } },
    { "wait": 2 },

    { "aimAt": { "world": [42, 38] } },
    { "wait": 2 },
    { "comment": "The field under the pointer is outlined.", "expect": "hoveredField", "notEquals": null },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "fieldDetail" },
    { "expect": "ui.title", "equals": "Iron Ore" },
    { "expect": "ui.rows.remaining", "equals": "1000 / 1000" },
    { "expect": "ui.rows.workedBy", "equals": "nothing" },
    { "comment": "The biome and gather speeds are not shown.", "expect": "ui.rows.biome", "exists": false },

    { "comment": "Two Mines beside the field, each 1 unit from its square.", "placeBuilding": { "type": "Mine", "anchor": [44, 34] } },
    { "placeBuilding": { "type": "Mine", "anchor": [40, 34] } },
    { "comment": "Small Hubs from the HQ put both Mines online (collectors work only online).", "placeBuilding": { "type": "SmallHub", "anchor": [50, 20] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [46, 30] } },
    { "aimAt": { "world": [36, 30] } },
    { "wait": 2 },
    { "comment": "With the pointer elsewhere, the open field keeps its outline.", "expect": "hoveredField", "equals": null },
    { "expect": "focusedField", "notEquals": null },
    { "expect": "ui.rows.workedBy", "equals": "2 Mines" },
    { "comment": "Each Mine takes a unit of Iron Ore every 8 s.", "wait": 250 },
    { "expect": "ui.rows.remaining", "equals": "998 / 1000" },
    { "screenshot": "ore-field" },

    { "comment": "Clicking a building switches to its panel.", "aimAt": { "world": [45, 35] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "focusedField", "equals": null },

    { "comment": "And a field switches back.", "aimAt": { "world": [50, 38] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "fieldDetail" },
    { "expect": "ui.title", "equals": "Wood" },
    { "expect": "ui.rows.remaining", "equals": "2000 / 2000" },
    { "screenshot": "forest-field" },

    { "comment": "Empty ground closes the panel.", "aimAt": { "world": [34, 30] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "aimAt": { "world": [42, 38] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "fieldDetail" },
    { "comment": "The panel closes when its field depletes.", "setResourceAmount": { "mapCell": [10, 9], "amount": 0 } },
    { "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "focusedField", "equals": null }
  ]
}
