{
  "$schema": "../scenario.schema.json",
  "name": "later-tiers",
  "description": "The later tiers beside the HQ: a Sawmill makes Lumber; a Cement Kiln burns fuel to make Cement and a Concrete Mixer on Sand and Water turns it into Concrete; a Brine Well on a salt flat pumps Lithium into a Stockyard; a Semiconductor Fab's display stand changes with its recipe.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 60 } },
    { "seedStockpile": { "type": "Wood", "amount": 4 } },
    { "seedStockpile": { "type": "Limestone", "amount": 2 } },
    { "seedStockpile": { "type": "Silicon", "amount": 1 } },
    { "comment": "Power, Water, and Sand: two Burner Generators, two Water Pumps on the pond at map cell (13, 4), and a Sand Collector on Sand at (12, 4).", "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [46, 0] } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[13, 4]] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [52, 14] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [54, 14] } },
    { "changeTiles": { "type": "Sand", "cells": [[12, 4]] } },
    { "placeBuilding": { "type": "SandCollector", "anchor": [48, 16] } },
    { "teleportPlayer": { "x": 36, "z": 24 } },

    { "placeBuilding": { "type": "Sawmill", "anchor": [48, 4] } },
    { "queueCraft": { "anchor": [48, 4], "recipe": 0, "count": 99 } },
    { "placeBuilding": { "type": "CementKiln", "anchor": [44, 4] } },
    { "queueCraft": { "anchor": [44, 4], "recipe": 0, "count": 99 } },
    { "placeBuilding": { "type": "ConcreteMixer", "anchor": [51, 4] } },
    { "queueCraft": { "anchor": [51, 4], "recipe": 0, "count": 99 } },
    { "comment": "A salt flat at map cells (10, 1..2), a Brine Well on it, a Small Hub to bring it online, and a Stockyard for its Lithium.", "changeTiles": { "type": "SaltFlat", "biome": "Desert", "cells": [[10, 1], [10, 2]] } },
    { "placeBuilding": { "type": "BrineWell", "anchor": [40, 4] } },
    { "placeBuilding": { "type": "SmallHub", "anchor": [45, 13] } },
    { "placeBuilding": { "type": "Stockyard", "anchor": [52, 9] } },
    { "placeBuilding": { "type": "SemiconductorFab", "anchor": [40, 16] } },
    { "queueCraft": { "anchor": [40, 16], "recipe": 0, "count": 2 } },
    { "queueCraft": { "anchor": [40, 16], "recipe": 1, "count": 1 } },
    { "wait": 2 },
    { "expect": "buildings[6].online", "equals": true },
    { "expect": "buildings[7].online", "equals": true },
    { "expect": "buildings[8].online", "equals": true },
    { "expect": "buildings[9].online", "equals": true },
    { "expect": "buildings[12].display", "equals": "SiliconWafer" },

    { "comment": "Two 8 s Lumber cycles; a 12 s Cement cycle, then a 10 s Concrete one; two 10 s Lithium cycles; a 10 s Silicon Wafer cycle.", "wait": 750 },
    { "expect": "stockpile.Lumber", "equals": 2 },
    { "expect": "stockpile.Concrete", "equals": 2 },
    { "expect": "stockpile.Lithium", "equals": 2 },
    { "comment": "The Silicon Wafer order done, the Processor order is first.", "expect": "buildings[12].recipe", "equals": "Processor" },
    { "expect": "buildings[12].display", "equals": "Processor" },
    { "screenshot": "later-tiers" }
  ]
}
