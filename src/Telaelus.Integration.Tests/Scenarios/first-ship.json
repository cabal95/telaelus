{
  "$schema": "../scenario.schema.json",
  "name": "first-ship",
  "description": "The first ship: a Fabricator makes Hull Plate from Steel, its display stand shows the part and changes with its recipe; once a Shipyard stands, its panel shows the ship bill short and Launch ship disabled; with the whole bill in storage the ship shows on its pad and the panel's Launch ship launches it.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 180 } },
    { "seedStockpile": { "type": "Steel", "amount": 20 } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [52, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [48, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [40, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [36, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [32, 0] } },
    { "teleportPlayer": { "x": 40, "z": 24 } },
    { "placeBuilding": { "type": "Fabricator", "anchor": [48, 4] } },
    { "queueCraft": { "anchor": [48, 4], "recipe": 0, "count": 1 } },
    { "queueCraft": { "anchor": [48, 4], "recipe": 1, "count": 1 } },
    { "wait": 2 },
    { "expect": "buildings[7].recipe", "equals": "Hull Plate" },
    { "expect": "buildings[7].display", "equals": "HullPlate" },
    { "comment": "Twelve seconds a Hull Plate.", "wait": 370 },
    { "expect": "stockpile.HullPlate", "equals": 1 },
    { "comment": "The Hull Plate order done, the Steel Beam order runs and the stand shows it.", "expect": "buildings[7].recipe", "equals": "Steel Beam" },
    { "expect": "buildings[7].display", "equals": "SteelBeam" },
    { "screenshot": "fabricator" },

    { "placeBuilding": { "type": "Shipyard", "anchor": [44, 12] } },
    { "wait": 2 },
    { "expect": "buildings[8].online", "equals": true },
    { "aimAt": { "world": [48, 18] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "Short of the bill, Launch ship shows but cannot be pressed: the hint the first time.", "expect": "ui.launch", "equals": { "bill": ["0 / 4", "0 / 1", "0 / 1", "0 / 500", "0 / 200"], "button": "Launch ship", "enabled": false, "note": "Needs the whole bill in storage", "ships": null } },
    { "screenshot": "shipyard-short" },
    { "seedStockpile": { "type": "HullSection", "amount": 4 } },
    { "seedStockpile": { "type": "Engine", "amount": 1 } },
    { "seedStockpile": { "type": "ControlModule", "amount": 1 } },
    { "seedStockpile": { "type": "RocketFuel", "amount": 500 } },
    { "seedStockpile": { "type": "LiquidOxygen", "amount": 200 } },
    { "wait": 2 },
    { "expect": "ui.launch.enabled", "equals": true },
    { "expect": "ui.launch.note", "equals": null },
    { "screenshot": "ship-on-pad" },
    { "comment": "L no longer launches; the panel's button does.", "press": "L" },
    { "wait": 2 },
    { "expect": "shipsLaunched", "equals": 0 },
    { "clickUi": { "id": "buildingDetail/launch" } },
    { "wait": 2 },
    { "expect": "shipsLaunched", "equals": 1 },
    { "expect": "ui.launch.bill", "equals": ["0 / 4", "0 / 1", "0 / 1", "0 / 500", "0 / 200"] },
    { "expect": "ui.launch.ships", "equals": "Ships launched: 1" },
    { "expect": "ui.launch.enabled", "equals": false },
    { "screenshot": "launched" }
  ]
}
