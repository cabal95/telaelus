{
  "$schema": "../scenario.schema.json",
  "name": "terrain-types",
  "description": "Every terrain type (a salt flat in a ring of sand), a mountain on each ground that takes one (both model families), and rivers in every shape on grass, sand, snow, mud, and rock (with a mouth into water) render; a river channel blocks placement while its bank allows it; the snapshot reports the terrain, biome, and feature under the player.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Buildings cost resources.", "seedStockpile": { "type": "Wood", "amount": 500 } },
    { "seedStockpile": { "type": "Stone", "amount": 500 } },
    { "seedStockpile": { "type": "Iron", "amount": 500 } },
    { "comment": "A strip of every terrain along map row z 6, x 2 to 9.", "changeTiles": { "type": "Grass", "cells": [[2, 6]] } },
    { "changeTiles": { "type": "Sand", "biome": "Desert", "cells": [[3, 6]] } },
    { "changeTiles": { "type": "Snow", "biome": "Tundra", "cells": [[4, 6]] } },
    { "changeTiles": { "type": "Rock", "biome": "Highlands", "cells": [[5, 6]] } },
    { "changeTiles": { "type": "Mud", "biome": "Swamp", "cells": [[6, 6]] } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[7, 6]] } },
    { "changeTiles": { "type": "DeepWater", "biome": "Ocean", "cells": [[8, 6]] } },
    { "changeTiles": { "type": "Lava", "biome": "Volcanic", "cells": [[9, 6]] } },
    { "comment": "A mountain on every ground that takes one, as a 3 x 2 cluster: snow, sand, mud on row 6, then rock and grass on row 7.", "changeTiles": { "type": "Snow", "biome": "Tundra", "feature": "Mountain", "cells": [[11, 6]] } },
    { "changeTiles": { "type": "Sand", "biome": "Desert", "feature": "Mountain", "cells": [[12, 6]] } },
    { "changeTiles": { "type": "Mud", "biome": "Swamp", "feature": "Mountain", "cells": [[13, 6]] } },
    { "changeTiles": { "type": "Rock", "biome": "Highlands", "feature": "Mountain", "cells": [[11, 7]] } },
    { "changeTiles": { "feature": "Mountain", "cells": [[12, 7]] } },
    { "comment": "A river flowing east along map row z 10, from grass into desert sand.", "changeTiles": { "type": "Sand", "biome": "Desert", "from": [4, 10], "to": [5, 10] } },
    { "changeTiles": { "feature": "River", "flow": "East", "from": [2, 10], "to": [5, 10] } },
    { "comment": "A cross on snow: three ends flow into (10, 10), which flows south into an end.", "changeTiles": { "type": "Snow", "biome": "Tundra", "from": [9, 9], "to": [11, 11] } },
    { "changeTiles": { "feature": "River", "flow": "South", "cells": [[10, 9], [10, 10], [10, 11]] } },
    { "changeTiles": { "feature": "River", "flow": "East", "cells": [[9, 10]] } },
    { "changeTiles": { "feature": "River", "flow": "West", "cells": [[11, 10]] } },
    { "comment": "On mud: a bend at (6, 12) and a junction at (7, 12) that runs south into shallow water at (7, 14).", "changeTiles": { "type": "Mud", "biome": "Swamp", "from": [5, 11], "to": [8, 13] } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[6, 14], [7, 14], [8, 14]] } },
    { "changeTiles": { "feature": "River", "flow": "South", "cells": [[6, 11], [7, 12], [7, 13]] } },
    { "changeTiles": { "feature": "River", "flow": "East", "cells": [[6, 12]] } },
    { "changeTiles": { "feature": "River", "flow": "West", "cells": [[8, 12]] } },
    { "comment": "A pool on rock: its flow faces dry land, so it connects nowhere.", "changeTiles": { "type": "Rock", "biome": "Highlands", "feature": "River", "flow": "East", "cells": [[12, 10]] } },
    { "teleportPlayer": { "x": 26, "z": 34 } },
    { "cameraZoom": { "size": 40 } },
    { "wait": 10 },
    { "screenshot": "overview" },
    { "teleportPlayer": { "x": 34, "z": 46 } },
    { "cameraZoom": { "size": 22 } },
    { "wait": 10 },
    { "screenshot": "river-shapes" },
    { "teleportPlayer": { "x": 12.5, "z": 40.5 } },
    { "expect": "player.terrain", "equals": "Grass" },
    { "expect": "player.biome", "equals": "Grassland" },
    { "expect": "player.feature", "equals": "River" },
    { "teleportPlayer": { "x": 20.5, "z": 43.5 } },
    { "expect": "player.terrain", "equals": "Sand" },
    { "expect": "player.biome", "equals": "Desert" },
    { "teleportPlayer": { "x": 45.5, "z": 25.5 } },
    { "expect": "player.terrain", "equals": "Snow" },
    { "expect": "player.feature", "equals": "Mountain" },
    { "comment": "A salt flat in desert sand: map cells (13..14, 3..4) inside a sand ring (12..15, 2..5).", "changeTiles": { "type": "Sand", "biome": "Desert", "from": [12, 2], "to": [15, 5] } },
    { "changeTiles": { "type": "SaltFlat", "from": [13, 3], "to": [14, 4] } },
    { "teleportPlayer": { "x": 56, "z": 16 } },
    { "expect": "player.terrain", "equals": "SaltFlat" },
    { "expect": "player.biome", "equals": "Desert" },
    { "cameraZoom": { "size": 20 } },
    { "wait": 10 },
    { "screenshot": "salt-flat" },
    { "teleportPlayer": { "x": 26, "z": 34 } },
    { "cameraZoom": { "size": 20 } },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Smelter" } },
    { "wait": 1 },
    { "comment": "Map cell (3, 10) runs east-west: channel rows z 41 and 42. A Smelter aimed at (13, 41) is anchored at (12, 40) and reaches the channel.", "aimAt": { "cell": [13, 41] } },
    { "wait": 10 },
    { "screenshot": "ghost-on-channel" },
    { "expect": "build.ghost.anchor", "equals": [12, 40] },
    { "expect": "build.ghost.placeable", "equals": false },
    { "comment": "Centered on the grid corner (14, 39), it is anchored at (12, 37) and covers z 37 to 40: grass and the north bank.", "aimAt": { "world": [14, 39] } },
    { "wait": 2 },
    { "expect": "build.ghost.placeable", "equals": true }
  ]
}
