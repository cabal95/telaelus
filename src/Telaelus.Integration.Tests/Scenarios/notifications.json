{
  "$schema": "../scenario.schema.json",
  "name": "notifications",
  "description": "Toasts: a new world shows none; seeding Wood discovers Wood, a brief toast gone after 5 s; a finished research project shows a lasting toast with an X and a countdown, held while hovered and closed by its X, and a tier's unlock project adds a second, Tier 2 buildings and research are now available; a Water blackout and a ship launch each show a lasting toast; a fifth toast pushes out the oldest brief one; an unclosed lasting toast is gone after 15 s.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "wait": 2 },
    { "comment": "A new world notifies nothing.", "expect": "ui.toasts", "equals": [] },

    { "seedStockpile": { "type": "Wood", "amount": 15 } },
    { "wait": 1 },
    { "comment": "Holding a cost unlocks nothing; the discovery is the only toast.", "expect": "ui.toasts", "equals": [
      { "style": "brief", "title": "Discovered: Wood", "detail": "A Lumber Camp, a Lumber Mill or an Advanced Lumber Mill can work it", "remaining": 5, "shown": true }
    ] },
    { "wait": 8 },
    { "screenshot": "brief" },
    { "comment": "A modal hides the stack, which waits behind it: the toasts do not count down.", "press": "B" },
    { "wait": 8 },
    { "expect": "ui.open", "equals": "buildMenu" },
    { "expect": "ui.toasts[0].shown", "equals": false },
    { "expect": "ui.toasts[0].remaining", "equals": 4.7 },
    { "screenshot": "covered" },
    { "wait": 200 },
    { "expect": "ui.toasts[0].remaining", "equals": 4.7 },
    { "comment": "A discovery under the menu joins the hidden stack.", "seedStockpile": { "type": "Coal", "amount": 1 } },
    { "wait": 2 },
    { "expect": "ui.toasts[0].title", "equals": "Discovered: Coal" },
    { "expect": "ui.toasts[0].shown", "equals": false },
    { "press": "Escape" },
    { "wait": 8 },
    { "expect": "ui.open", "equals": null },
    { "expect": "ui.toasts[0].shown", "equals": true },
    { "comment": "It held at 4.7 behind the menu and counts down again.", "expect": "ui.toasts[1].remaining", "gte": 4.3 },
    { "comment": "5 s and the fade later, both are gone.", "wait": 152 },
    { "expect": "ui.toasts", "equals": [] },

    { "seedStockpile": { "type": "Coal", "amount": 60 } },
    { "seedStockpile": { "type": "Iron", "amount": 40 } },
    { "seedStockpile": { "type": "Copper", "amount": 20 } },
    { "comment": "Glass for Steel Works' fee, discovered now so its toast is gone before the research.", "seedStockpile": { "type": "Glass", "amount": 40 } },
    { "comment": "Three Burner Generators (105 Power) cover the Lab, a Refinery, and the Shipyard below.", "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [40, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [36, 0] } },
    { "placeBuilding": { "type": "ResearchLab", "anchor": [48, 4] } },
    { "wait": 160 },
    { "expect": "ui.toasts", "equals": [] },
    { "startResearch": "MaterialTransfer" },
    { "setResearchProgress": { "project": "MaterialTransfer", "seconds": 1199.98 } },
    { "wait": 2 },
    { "expect": "ui.toasts[0].style", "equals": "lasting" },
    { "expect": "ui.toasts[0].title", "equals": "Research complete: Material Transfer" },
    { "expect": "ui.toasts[0].detail", "equals": "The network carries Wood, Stone, Iron Ore, Copper Ore, and Coal from online collectors straight into storage." },
    { "hoverUi": { "id": "toast/0" } },
    { "wait": 60 },
    { "comment": "Two seconds under the pointer and it has not counted down.", "expect": "ui.toasts[0].remaining", "equals": 14.9 },
    { "screenshot": "lasting" },
    { "clickUi": { "id": "toast/0/close" } },
    { "wait": 12 },
    { "expect": "ui.toasts", "equals": [] },

    { "comment": "Steel Works unlocks tier 2: its research toast, then the tier toast above it.", "seedStockpile": { "type": "Iron", "amount": 60 } },
    { "seedStockpile": { "type": "Copper", "amount": 60 } },
    { "seedStockpile": { "type": "Wood", "amount": 80 } },
    { "startResearch": "SteelWorks" },
    { "setResearchProgress": { "project": "SteelWorks", "seconds": 1199.98 } },
    { "wait": 2 },
    { "expect": "unlockedTier", "equals": 2 },
    { "expect": "ui.toasts", "equals": [
      { "style": "lasting", "title": "Tier 2 buildings and research are now available", "detail": "[B] to build", "remaining": 14.9, "shown": true },
      { "style": "lasting", "title": "Research complete: Steel Works", "detail": "Unlocks Tier 2 buildings: steel, oil, and the chemistry they open up.", "remaining": 14.9, "shown": true }
    ] },
    { "screenshot": "tier" },
    { "clickUi": { "id": "toast/0/close" } },
    { "wait": 12 },
    { "clickUi": { "id": "toast/0/close" } },
    { "wait": 12 },
    { "expect": "ui.toasts", "equals": [] },

    { "placeBuilding": { "type": "Refinery", "anchor": [52, 12] } },
    { "wait": 2 },
    { "comment": "The Burner Generators cover its Power; nothing supplies its Water.", "expect": "ui.toasts", "equals": [
      { "style": "lasting", "title": "Blackout: Water", "detail": "Demand 2 over supply 0", "remaining": 14.9, "shown": true }
    ] },
    { "seedStockpile": { "type": "HullSection", "amount": 4 } },
    { "seedStockpile": { "type": "Engine", "amount": 1 } },
    { "seedStockpile": { "type": "ControlModule", "amount": 1 } },
    { "seedStockpile": { "type": "RocketFuel", "amount": 500 } },
    { "seedStockpile": { "type": "LiquidOxygen", "amount": 200 } },
    { "placeBuilding": { "type": "Shipyard", "anchor": [40, 14] } },
    { "wait": 2 },
    { "comment": "A burst of discoveries is one toast, with no detail line.", "expect": "ui.toasts[0].title", "equals": "Discovered: Hull Section, Engine, Control Module, Rocket Fuel, Liquid Oxygen" },
    { "expect": "ui.toasts[0].detail", "equals": null },
    { "comment": "The camera follows the player, so the Shipyard comes out from under the stack on the right.", "teleportPlayer": { "x": 44, "z": 29 } },
    { "wait": 2 },
    { "aimAt": { "world": [44, 20] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "clickUi": { "id": "buildingDetail/launch" } },
    { "wait": 2 },
    { "expect": "ui.toasts[0].title", "equals": "Ship launched" },
    { "expect": "ui.toasts[0].style", "equals": "lasting" },
    { "expect": "ui.toasts[0].detail", "equals": "Ships launched: 1" },

    { "comment": "Three more brief toasts: the fifth and sixth push out the oldest brief ones, never a lasting one.", "seedStockpile": { "type": "Sulfur", "amount": 1 } },
    { "wait": 1 },
    { "seedStockpile": { "type": "Quartz", "amount": 1 } },
    { "wait": 1 },
    { "seedStockpile": { "type": "Lithium", "amount": 1 } },
    { "wait": 1 },
    { "expect": "ui.toasts[4]", "exists": false },
    { "expect": "ui.toasts[0].title", "equals": "Discovered: Lithium" },
    { "expect": "ui.toasts[1].title", "equals": "Discovered: Quartz" },
    { "expect": "ui.toasts[2].title", "equals": "Ship launched" },
    { "expect": "ui.toasts[3].title", "equals": "Blackout: Water" },
    { "wait": 8 },
    { "screenshot": "stack" },

    { "comment": "Unclosed and unhovered, the lasting toasts are gone after 15 s.", "press": "Escape" },
    { "wait": 450 },
    { "expect": "ui.toasts", "equals": [] }
  ]
}
