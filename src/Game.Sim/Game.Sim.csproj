<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Game.Sim</RootNamespace>
    <!-- Run code-style (IDE*) analyzers, configured in .editorconfig, during build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Godot math types only (Vector2, Vector3, Mathf). Keep in step with the
         Godot.NET.Sdk version in ../Game/Game.csproj. -->
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>
</Project>
