; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/bg_color=Color(0.1, 0.12, 0.11, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

config/name="Game"
run/main_scene="res://scenes/App.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[dotnet]

project/assembly_name="Game"

[filesystem]

import/blender/enabled=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
