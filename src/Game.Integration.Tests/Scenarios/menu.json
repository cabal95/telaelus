{
  "$schema": "../scenario.schema.json",
  "name": "menu",
  "description": "The app's start: the loading screen runs to the end and gives way to the main menu over the town (New Game and Quit); newGame goes into a game, and a second newGame replaces it with a fresh world.",
  "steps": [
    { "comment": "A scenario's first command runs once loading is done.", "expect": "app", "equals": "menu" },
    { "expect": "loading", "equals": 1 },
    { "expect": "ui.open", "equals": "mainMenu" },
    { "expect": "ui.menu.title", "equals": "Game" },
    { "expect": "ui.menu.buttons", "equals": ["New Game", "Quit"] },
    { "wait": 30 },
    { "screenshot": "menu" },

    { "newGame": {} },
    { "expect": "app", "equals": "game" },
    { "expect": "ui.open", "equals": null },
    { "expect": "buildings[0].type", "equals": "Hq" },
    { "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "expect": "stockpile.Wood", "equals": 30 },
    { "screenshot": "game" },

    { "comment": "A second newGame replaces the game with a fresh world.", "newGame": { "seed": 2 } },
    { "expect": "app", "equals": "game" },
    { "expect": "stockpile.Wood", "equals": 0 }
  ]
}
