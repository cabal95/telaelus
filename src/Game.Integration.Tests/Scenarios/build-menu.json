{
  "$schema": "../scenario.schema.json",
  "name": "build-menu",
  "description": "B opens the build menu: discovered buildings first (color when affordable, gray when not), then undiscovered ones; a hover shows the cost (none for undiscovered); a modal menu stops the world; clicking a discovered cell selects it for placement with the placement tooltip; B, Escape, and the close button close the menu.",
  "steps": [
    { "initMap": {} },
    { "comment": "30 Wood and 15 Stone unlock the Lumber Camp, the Mine, and the Silo; spending 10 Stone leaves the Mine short.", "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Stone", "amount": 15 } },
    { "seedStockpile": { "type": "Stone", "amount": -10 } },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildMenu" },
    { "expect": "ui.cells", "equals": [
      { "type": "LumberCamp", "state": "affordable", "label": "Lumber Camp" },
      { "type": "Mine", "state": "unaffordable", "label": "Mine" },
      { "type": "SandCollector", "state": "unaffordable", "label": "Sand Collector" },
      { "type": "Silo", "state": "affordable", "label": "Silo" },
      { "type": "SmallHub", "state": "affordable", "label": "Small Hub" },
      { "type": "WaterPump", "state": "unaffordable", "label": "Water Pump" },
      { "type": "AluminumSmelter", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "BurnerGenerator", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "CharcoalKiln", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ChemicalPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DeepMine", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DeepWell", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Depot", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "DrillRig", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "ElectricFurnace", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Electrolyzer", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Forester", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "FuelPlant", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Glassworks", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "LumberMill", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "OilWell", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "PumpingStation", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Quarry", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Refinery", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Relay", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "RockCrusher", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SandDredge", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Smelter", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "SteelMill", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Stockyard", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "TankFarm", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Vault", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "Warehouse", "state": "undiscovered", "label": "Undiscovered" },
      { "type": "WaterWheel", "state": "undiscovered", "label": "Undiscovered" }
    ] },

    { "comment": "The modal menu takes all input: holding D moves nothing.", "keyDown": "D" },
    { "wait": 10 },
    { "keyUp": "D" },
    { "expect": "player.position[0]", "approx": 32 },

    { "hoverUi": { "id": "buildMenu/Mine" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["25 Wood", "15 Stone (have 5)"] },
    { "screenshot": "menu-hover" },
    { "hoverUi": { "id": "buildMenu/AluminumSmelter" } },
    { "wait": 15 },
    { "comment": "An undiscovered building keeps its cost a mystery.", "expect": "ui.tooltip", "equals": null },
    { "clickUi": { "id": "buildMenu/AluminumSmelter" } },
    { "wait": 1 },
    { "comment": "Clicking an undiscovered cell does nothing.", "expect": "ui.open", "equals": "buildMenu" },

    { "press": "B" },
    { "wait": 1 },
    { "comment": "B toggles the menu closed.", "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/close" } },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },
    { "press": "B" },
    { "wait": 1 },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "comment": "An unaffordable but discovered building can be selected and positioned.", "expect": "ui.open", "equals": null },
    { "expect": "build.selected", "equals": "Mine" },
    { "aimAt": { "world": [29, 29] } },
    { "wait": 2 },
    { "expect": "build.ghost.affordable", "equals": false },
    { "expect": "build.tooltip[0]", "equals": "Mine" },
    { "expect": "build.tooltip[2]", "equals": "15 Stone (have 5)" },
    { "screenshot": "placing" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "build", "equals": null }
  ]
}
