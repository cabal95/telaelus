{
  "$schema": "../scenario.schema.json",
  "name": "boot",
  "description": "Smoke test: the main scene loads, the world builds, and the game runs a few frames.",
  "steps": [
    { "initMap": {} },
    { "wait": 5 },
    { "screenshot": "spawn" },
    { "expect": "player.position[0]", "approx": 32 },
    { "expect": "player.position[1]", "approx": 32 },
    { "expect": "build", "equals": null },
    { "expect": "fields", "equals": [] },
    { "comment": "The world places the HQ in the empty map's north-east corner, and nothing else stands.", "expect": "buildings[0].type", "equals": "Hq" },
