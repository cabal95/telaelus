{
  "$schema": "../scenario.schema.json",
  "name": "power",
  "description": "Power on the HQ network: a Drill Rig with no supply is in a blackout; a Burner Generator on Coal powers it; Refineries push demand into a brownout (warning color) and then a blackout (danger color) on the top bar; the generator's panel shows what it supplies, what burns, and its Best fuel.",
  "steps": [
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 20 } },
    { "comment": "Beside the HQ in the north-east corner, so everything here is online.", "placeBuilding": { "type": "DrillRig", "anchor": [49, 13] } },
    { "wait": 2 },
    { "expect": "buildings[1].online", "equals": true },
    { "expect": "buildings[1].idleReason", "equals": "Blackout" },
    { "expect": "ui.topBar.power", "equals": "Blackout: Power 10 / 0" },

    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [53, 13] } },
    { "wait": 2 },
    { "expect": "power", "equals": { "supply": 100, "demand": 10, "speed": 1, "state": "normal" } },
    { "expect": "buildings[2].burning", "equals": "Coal" },
    { "expect": "ui.topBar.power", "equals": "Power 10 / 100" },

    { "comment": "Four Refineries (25 each): 110 against 100 is a brownout at 80%.", "placeBuilding": { "type": "Refinery", "anchor": [46, 4] } },
    { "placeBuilding": { "type": "Refinery", "anchor": [48, 4] } },
    { "placeBuilding": { "type": "Refinery", "anchor": [50, 4] } },
    { "placeBuilding": { "type": "Refinery", "anchor": [52, 4] } },
    { "teleportPlayer": { "x": 46, "z": 20 } },
    { "wait": 2 },
    { "expect": "power.state", "equals": "brownout" },
    { "expect": "power.speed", "approx": 0.8 },
    { "expect": "ui.topBar.power", "equals": "Power 110 / 100" },
    { "screenshot": "brownout" },

    { "comment": "A fifth: 135 against 100 is past a quarter over, a blackout.", "placeBuilding": { "type": "Refinery", "anchor": [46, 8] } },
    { "wait": 2 },
    { "expect": "power.state", "equals": "blackout" },
    { "expect": "ui.topBar.power", "equals": "Blackout: Power 135 / 100" },
    { "screenshot": "blackout" },

    { "aimAt": { "world": [54, 14] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.rows.power", "equals": "Supplies 100" },
    { "expect": "ui.fuel", "equals": "Best" },
    { "screenshot": "generator-detail" }
  ]
}
