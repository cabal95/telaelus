{
  "$schema": "../scenario.schema.json",
  "name": "first-ship",
  "description": "The first ship: a Fabricator makes Hull Plate from Steel, its display stand shows the part and changes with its recipe; with the whole ship bill in storage the top bar asks for a Shipyard; once one stands, the ship shows on its pad and L launches it.",
  "steps": [
    { "initMap": {} },
    { "seedStockpile": { "type": "Coal", "amount": 60 } },
    { "seedStockpile": { "type": "Steel", "amount": 20 } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [44, 0] } },
    { "placeBuilding": { "type": "BurnerGenerator", "anchor": [46, 0] } },
    { "teleportPlayer": { "x": 40, "z": 24 } },
    { "placeBuilding": { "type": "Fabricator", "anchor": [48, 4] } },
    { "wait": 2 },
    { "expect": "buildings[3].recipe", "equals": "Hull Plate" },
    { "expect": "buildings[3].display", "equals": "HullPlate" },
    { "comment": "Twelve seconds a Hull Plate.", "wait": 370 },
    { "expect": "stockpile.HullPlate", "equals": 1 },
    { "comment": "A change waits for the running cycle, but the stand shows the coming part at once.", "setRecipe": { "anchor": [48, 4], "index": 1 } },
    { "wait": 2 },
    { "expect": "buildings[3].recipe", "equals": "Hull Plate" },
    { "expect": "buildings[3].display", "equals": "SteelBeam" },
    { "screenshot": "fabricator" },

    { "seedStockpile": { "type": "HullSection", "amount": 4 } },
    { "seedStockpile": { "type": "Engine", "amount": 1 } },
    { "seedStockpile": { "type": "ControlModule", "amount": 1 } },
    { "seedStockpile": { "type": "RocketFuel", "amount": 500 } },
    { "seedStockpile": { "type": "LiquidOxygen", "amount": 200 } },
    { "wait": 2 },
    { "expect": "ui.topBar.launch", "equals": "Build a Shipyard to launch" },
    { "placeBuilding": { "type": "Shipyard", "anchor": [44, 12] } },
    { "wait": 2 },
    { "expect": "buildings[4].online", "equals": true },
    { "expect": "ui.topBar.launch", "equals": "[L] Launch ship" },
    { "screenshot": "ship-on-pad" },
    { "press": "L" },
    { "wait": 2 },
    { "expect": "shipsLaunched", "equals": 1 },
    { "expect": "ui.topBar.launch", "equals": "0 / 4   0 / 1   0 / 1   0 / 500   0 / 200   Ships: 1" },
    { "screenshot": "launched" }
  ]
}
