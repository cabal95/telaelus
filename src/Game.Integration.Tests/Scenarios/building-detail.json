{
  "$schema": "../scenario.schema.json",
  "name": "building-detail",
  "description": "Clicking a placed building opens its detail side panel: status rows, walking with it open, turning it off and on, switching to another building, closing by empty ground, B, and Escape, and destroying with a confirming second click for half the cost back.",
  "steps": [
    { "initMap": {} },
    { "comment": "A Mine centered at (45, 35) has these two Iron Ore fields and the Stone in range.", "placeResource": { "type": "IronOre", "mapCell": [10, 9] } },
    { "placeResource": { "type": "IronOre", "mapCell": [11, 10] } },
    { "placeResource": { "type": "Stone", "mapCell": [12, 8] } },
    { "placeBuilding": { "type": "Mine", "anchor": [44, 34] } },
    { "comment": "A Lumber Camp with no trees in range.", "placeBuilding": { "type": "LumberCamp", "anchor": [28, 28] } },
    { "wait": 2 },

    { "aimAt": { "world": [45, 35] } },
    { "wait": 2 },
    { "comment": "The building under the pointer is outlined.", "expect": "hoveredBuilding", "notEquals": null },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.rows.switch", "equals": "On" },
    { "expect": "ui.rows.state", "equals": "Working" },
    { "comment": "Two Grassland Iron Ore fields of 250 and one Stone field of 250.", "expect": "ui.rows.inRange", "equals": "Iron Ore 2 (500), Stone 1 (250)" },
    { "expect": "ui.rows.workingOn", "equals": "Iron Ore (250 left)" },
    { "expect": "ui.destroy", "equals": "Destroy (refund 13 Wood, 8 Stone)" },
    { "comment": "The open building keeps its outline with the pointer elsewhere.", "aimAt": { "world": [36, 28] } },
    { "wait": 1 },
    { "expect": "hoveredBuilding", "equals": null },
    { "expect": "focusedBuilding", "notEquals": null },
    { "comment": "The wheel over the panel, even past the end of its scroll, never zooms the world.", "scrollUi": { "id": "buildingDetail/toggle", "ticks": 6 } },
    { "wait": 1 },
    { "expect": "camera.zoom", "approx": 28 },
    { "screenshot": "detail" },

    { "comment": "A side panel leaves the world its input: the player walks with it open.", "keyDown": "D" },
    { "wait": 10 },
    { "keyUp": "D" },
    { "expect": "player.position[0]", "gte": 33 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "wait": 60 },
    { "screenshot": "detail-turned" },

    { "clickUi": { "id": "buildingDetail/toggle" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": false },
    { "expect": "ui.rows.switch", "equals": "Off" },
    { "expect": "ui.rows.state", "equals": "Idle: Switched off" },
    { "clickUi": { "id": "buildingDetail/toggle" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": true },

    { "comment": "Clicking another building switches the panel to it.", "aimAt": { "world": [29, 29] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "expect": "ui.rows.state", "equals": "Idle: No fields in range" },
    { "expect": "ui.rows.inRange", "equals": "none" },
    { "comment": "Only a building that works more than one type says what it is on.", "expect": "ui.rows.workingOn", "exists": false },

    { "comment": "A click on empty ground closes the panel.", "aimAt": { "world": [36, 28] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },
    { "expect": "focusedBuilding", "equals": null },

    { "aimAt": { "world": [29, 29] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "press": "B" },
    { "wait": 1 },
    { "comment": "Another overlay opening closes the panel.", "expect": "ui.open", "equals": "buildMenu" },
    { "press": "Escape" },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "aimAt": { "world": [45, 35] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "clickUi": { "id": "buildingDetail/destroy" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "comment": "The first click only arms the button.", "expect": "ui.destroy", "equals": "Confirm destroy" },
    { "expect": "buildings[2]", "exists": true },
    { "clickUi": { "id": "buildingDetail/destroy" } },
    { "comment": "A button acts on release, the frame after the click.", "wait": 2 },
    { "expect": "ui.open", "equals": null },
    { "expect": "buildings[2]", "exists": false },
    { "expect": "buildings[1].type", "equals": "LumberCamp" },
    { "expect": "stockpile.Wood", "equals": 13 },
    { "expect": "stockpile.Stone", "equals": 8 }
  ]
}
