{
  "$schema": "../scenario.schema.json",
  "name": "free-camera",
  "description": "Dragging the map: a right drag (or Ctrl + left) moves the camera, not the player, keeping the grabbed ground under the pointer; a tiny drag is a click; a drag over a modal does nothing; the camera stops at the explored area's edge; Space or moving brings it back, sliding when the player is on screen and jumping when not; buildings can be clicked while panned, and a Ctrl + left drag in build mode places nothing.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "A Mine to the east, to click on while panned.", "placeBuilding": { "type": "Mine", "anchor": [52, 30] } },
    { "wait": 30 },
    { "expect": "camera.detached", "equals": false },

    { "comment": "A drag of 2 pixels is a click, not a drag.", "drag": { "button": "right", "from": [640, 400], "to": [642, 400] } },
    { "expect": "camera.detached", "equals": false },

    { "comment": "200 pixels left at zoom 28 is 7.8 units: the view's center moves that far to screen right, toward +x and -z.", "drag": { "button": "right", "from": [640, 400], "to": [440, 400] } },
    { "expect": "camera.detached", "equals": true },
    { "expect": "player.position", "equals": [32, 32] },
    { "expect": "camera.target[0]", "approx": 37.5, "tolerance": 0.2 },
    { "expect": "camera.target[1]", "approx": 26.5, "tolerance": 0.2 },
    { "comment": "A detached camera stays put.", "wait": 10 },
    { "expect": "camera.target[0]", "approx": 37.5, "tolerance": 0.2 },
    { "screenshot": "panned" },

    { "comment": "Space slides it back over 0.25 s (about 8 frames): part way after 3, there after 10.", "press": "Space" },
    { "wait": 3 },
    { "expect": "camera.detached", "equals": false },
    { "expect": "camera.target[0]", "gte": 32.5 },
    { "expect": "camera.target[0]", "lte": 37 },
    { "wait": 10 },
    { "expect": "camera.target[0]", "approx": 32, "tolerance": 0.05 },
    { "expect": "player.position", "equals": [32, 32] },

    { "comment": "Ctrl + left drags the same way.", "drag": { "button": "left", "ctrl": true, "from": [640, 400], "to": [440, 400] } },
    { "expect": "camera.detached", "equals": true },
    { "expect": "camera.target[0]", "approx": 37.5, "tolerance": 0.2 },

    { "comment": "Clicking a building works while panned.", "aimAt": { "world": [53, 31] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "comment": "UI buttons take no keyboard focus, so Space after clicking one does not press it again.", "clickUi": { "id": "buildingDetail/toggle" } },
    { "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": false },
    { "press": "Space" },
    { "wait": 2 },
    { "expect": "buildings[1].enabled", "equals": false },
    { "comment": "With the player under the open panel (the left third), they count as off screen: moving jumps the camera back.", "drag": { "button": "right", "from": [900, 400], "to": [450, 400] } },
    { "expect": "camera.detached", "equals": true },
    { "keyDown": "D" },
    { "wait": 1 },
    { "keyUp": "D" },
    { "wait": 1 },
    { "expect": "camera.detached", "equals": false },
    { "expect": "camera.target[0]", "lte": 32.6 },
    { "press": "Escape" },
    { "wait": 1 },

    { "drag": { "button": "right", "from": [640, 400], "to": [440, 400] } },
    { "comment": "Moving with the player on screen slides the camera back.", "keyDown": "D" },
    { "wait": 1 },
    { "keyUp": "D" },
    { "expect": "camera.detached", "equals": false },
    { "wait": 12 },
    { "expect": "camera.target[0]", "approx": 32.15, "tolerance": 0.4 },

    { "comment": "Far to screen right: the camera stops at the map's edge (no fog: the whole map).", "drag": { "button": "right", "from": [1200, 400], "to": [40, 400] } },
    { "drag": { "button": "right", "from": [1200, 400], "to": [40, 400] } },
    { "expect": "camera.target[0]", "lte": 64 },
    { "expect": "camera.target[1]", "gte": 0 },
    { "screenshot": "edge" },
    { "comment": "The player is off screen now, so moving jumps the camera straight back.", "keyDown": "W" },
    { "wait": 1 },
    { "keyUp": "W" },
    { "wait": 1 },
    { "expect": "camera.detached", "equals": false },
    { "expect": "camera.target[0]", "lte": 32.3 },

    { "comment": "A drag over a modal (the build menu) does nothing.", "seedStockpile": { "type": "Wood", "amount": 100 } },
    { "seedStockpile": { "type": "Stone", "amount": 100 } },
    { "press": "B" },
    { "wait": 1 },
    { "drag": { "button": "right", "from": [640, 360], "to": [440, 360] } },
    { "expect": "camera.detached", "equals": false },
    { "expect": "ui.open", "equals": "buildMenu" },

    { "comment": "In build mode a Ctrl + left drag pans and places nothing.", "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 2 },
    { "drag": { "button": "left", "ctrl": true, "from": [640, 300], "to": [540, 300] } },
    { "expect": "camera.detached", "equals": true },
    { "expect": "build.selected", "equals": "Mine" },
    { "expect": "buildings[2]", "exists": false }
  ]
}
