{
  "$schema": "../scenario.schema.json",
  "name": "hud",
  "description": "The screen UI: the debug overlay starts hidden and F3 toggles it; the top bar shows all eight raw resources with name tooltips and the launch progress; the hint overlay shows the harvest hint and its bar; I opens and closes the inventory, grouped by tier with discovered resources first; the inventory and a building's detail panel replace each other; a panel covers the debug overlay.",
  "steps": [
    { "initMap": {} },
    { "wait": 2 },
    { "comment": "Debug data is off by default.", "expect": "ui.debug", "equals": false },
    { "press": "F3" },
    { "wait": 1 },
    { "expect": "ui.debug", "equals": true },
    { "press": "F3" },
    { "wait": 1 },
    { "expect": "ui.debug", "equals": false },

    { "seedStockpile": { "type": "Wood", "amount": 30 } },
    { "seedStockpile": { "type": "Iron", "amount": 12 } },
    { "wait": 1 },
    { "expect": "ui.topBar.items[0]", "equals": { "type": "Wood", "amount": 30 } },
    { "comment": "All eight raw resources, Sand and Water last.", "expect": "ui.topBar.items[7]", "equals": { "type": "Water", "amount": 0 } },
    { "expect": "ui.topBar.items[8]", "exists": false },
    { "expect": "ui.topBar.launch", "equals": "0 / 500   12 / 100" },
    { "hoverUi": { "id": "topBar/Stone" } },
    { "wait": 15 },
    { "expect": "ui.tooltip", "equals": ["Stone"] },
    { "screenshot": "top-bar" },

    { "comment": "Map cell (8, 7) spans z 28..32; the player stands 1 unit past its edge.", "placeResource": { "type": "Wood", "mapCell": [8, 7] } },
    { "teleportPlayer": { "x": 33.5, "z": 33 } },
    { "wait": 2 },
    { "expect": "ui.hint.text", "equals": "[E] Harvest Wood" },
    { "keyDown": "E" },
    { "wait": 45 },
    { "expect": "ui.hint.progress", "gte": 0.4 },
    { "screenshot": "hint" },
    { "keyUp": "E" },
    { "teleportPlayer": { "x": 40, "z": 30 } },
    { "wait": 2 },
    { "expect": "ui.hint", "equals": null },

    { "press": "I" },
    { "wait": 2 },
    { "expect": "ui.open", "equals": "inventory" },
    { "expect": "ui.inventory[0]", "equals": { "type": "Wood", "amount": 30, "section": "raw", "discovered": true } },
    { "comment": "Undiscovered raw resources follow the discovered ones; Lithium is the last raw row.", "expect": "ui.inventory[16]", "equals": { "type": "Lithium", "amount": 0, "section": "raw", "discovered": false } },
    { "expect": "ui.inventory[17]", "equals": { "type": "Iron", "amount": 12, "section": "tier1", "discovered": true } },
    { "expect": "ui.inventory[18]", "equals": { "type": "RocketFuel", "amount": 0, "section": "tier1", "discovered": false } },
    { "comment": "A panel leaves the world its input.", "keyDown": "D" },
    { "wait": 5 },
    { "keyUp": "D" },
    { "expect": "player.position[0]", "gte": 40.5 },
    { "press": "F3" },
    { "wait": 2 },
    { "comment": "The debug overlay shows, and the open panel may cover it.", "expect": "ui.debug", "equals": true },
    { "screenshot": "inventory" },
    { "press": "F3" },
    { "press": "I" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null },

    { "comment": "One panel at a time: the inventory and a building's detail replace each other.", "placeBuilding": { "type": "LumberCamp", "anchor": [44, 36] } },
    { "press": "I" },
    { "wait": 1 },
    { "aimAt": { "world": [45, 37] } },
    { "wait": 1 },
    { "click": {} },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "buildingDetail" },
    { "press": "I" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": "inventory" },
    { "press": "Escape" },
    { "wait": 1 },
    { "expect": "ui.open", "equals": null }
  ]
}
