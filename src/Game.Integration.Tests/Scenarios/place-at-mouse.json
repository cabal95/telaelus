{
  "$schema": "../scenario.schema.json",
  "name": "place-at-mouse",
  "description": "Aiming and clicking places a Mine centered on the pointer, and the ghost counts Ore fields in its work area. Mouse-to-anchor mapping and the range count are presentation.",
  "steps": [
    { "newGame": {} },
    { "initMap": {} },
    { "comment": "Buildings cost resources and unlock once their materials are held.", "seedStockpile": { "type": "Wood", "amount": 500 } },
    { "seedStockpile": { "type": "Stone", "amount": 500 } },
    { "seedStockpile": { "type": "Iron", "amount": 500 } },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "comment": "A 2x2 Mine centered on the grid corner (21, 21) is anchored at (20, 20).", "aimAt": { "world": [21, 21] } },
    { "wait": 2 },
    { "expect": "build.ghost.anchor", "equals": [20, 20] },
    { "expect": "build.ghost.placeable", "equals": true },
    { "expect": "build.fieldsInRange", "equals": 0 },
    { "click": {} },
    { "wait": 2 },
    { "screenshot": "placed" },
    { "expect": "buildings[1].type", "equals": "Mine" },
    { "expect": "buildings[1].anchor", "equals": [20, 20] },
    { "expect": "build.ghost.placeable", "equals": false },
    { "comment": "Map cell (6, 5) spans x 24..28, 3 units from the Mine's center.", "placeResource": { "type": "IronOre", "mapCell": [6, 5] } },
    { "wait": 1 },
    { "expect": "build.fieldsInRange", "equals": 1 }
  ]
}
