{
  "$schema": "../scenario.schema.json",
  "name": "building-models",
  "description": "Every building type renders its model, the Refinery in all four facings; placement still works with models; the ghost is a tinted copy of the selected building that turns with R and goes red over a blocked spot.",
  "steps": [
    { "initMap": {} },
    { "comment": "Buildings cost resources and unlock once their materials are held.", "seedStockpile": { "type": "Wood", "amount": 500 } },
    { "seedStockpile": { "type": "Stone", "amount": 500 } },
    { "seedStockpile": { "type": "Iron", "amount": 500 } },
    { "comment": "Row 1: one of each type facing North.", "placeBuilding": { "type": "Mine", "anchor": [18, 20] } },
    { "placeBuilding": { "type": "LumberCamp", "anchor": [22, 20] } },
    { "placeBuilding": { "type": "Smelter", "anchor": [26, 20] } },
    { "placeBuilding": { "type": "Refinery", "anchor": [31, 20] } },
    { "comment": "Row 2: the Refinery in each facing (East and West are 3 x 2).", "placeBuilding": { "type": "Refinery", "anchor": [18, 26], "facing": "North" } },
    { "placeBuilding": { "type": "Refinery", "anchor": [22, 26], "facing": "East" } },
    { "placeBuilding": { "type": "Refinery", "anchor": [27, 26], "facing": "South" } },
    { "placeBuilding": { "type": "Refinery", "anchor": [31, 26], "facing": "West" } },
    { "expect": "buildings[7].type", "equals": "Refinery" },
    { "teleportPlayer": { "x": 26, "z": 28 } },
    { "cameraZoom": { "size": 20 } },
    { "wait": 10 },
    { "screenshot": "buildings" },
    { "comment": "Ghosts on open ground below the rows.", "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "aimAt": { "world": [21, 35] } },
    { "wait": 2 },
    { "expect": "build.ghost.placeable", "equals": true },
    { "screenshot": "ghost-mine" },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/LumberCamp" } },
    { "wait": 1 },
    { "wait": 2 },
    { "screenshot": "ghost-lumber-camp" },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Smelter" } },
    { "wait": 1 },
    { "wait": 2 },
    { "screenshot": "ghost-smelter" },
    { "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Refinery" } },
    { "wait": 1 },
    { "press": "R" },
    { "wait": 2 },
    { "expect": "build.facing", "equals": "East" },
    { "screenshot": "ghost-refinery-east" },
    { "comment": "Over the Smelter the ghost is blocked and turns red.", "aimAt": { "world": [27.5, 21.5] } },
    { "wait": 2 },
    { "expect": "build.ghost.placeable", "equals": false },
    { "screenshot": "ghost-blocked" },
    { "comment": "Placing still works: a Mine at the open spot.", "press": "B" },
    { "wait": 1 },
    { "clickUi": { "id": "buildMenu/Mine" } },
    { "wait": 1 },
    { "aimAt": { "world": [21, 35] } },
    { "wait": 2 },
    { "click": {} },
    { "wait": 2 },
    { "expect": "buildings[8].type", "equals": "Mine" },
    { "expect": "buildings[8].anchor", "equals": [20, 34] }
  ]
}
