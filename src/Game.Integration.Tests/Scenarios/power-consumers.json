{
  "$schema": "../scenario.schema.json",
  "name": "power-consumers",
  "description": "Power from the later tiers through a day: at midday a Solar Array supplies its full 60 Power and a Battery Bank charges from it, shown on the top bar with the clock, the bolt, and the battery readout; at night the array gives nothing and the bank carries a Drill Rig, the store falling in the warning color; a Fission Reactor on Fuel Rods and Water then supplies 400 Power.",
  "steps": [
    { "initMap": {} },
    { "setTimeOfDay": 0.5 },
    { "teleportPlayer": { "x": 36, "z": 24 } },
    { "placeBuilding": { "type": "SolarArray", "anchor": [48, 4] } },
    { "placeBuilding": { "type": "BatteryBank", "anchor": [44, 4] } },
    { "wait": 1 },
    { "expect": "buildings[1].online", "equals": true },
    { "expect": "buildings[2].online", "equals": true },
    { "expect": "ui.topBar.clock", "equals": "12:00" },
    { "expect": "capacity.power.supply", "equals": 60 },
    { "comment": "60 spare, but a bank takes 50 a second.", "expect": "capacity.power.storeFlow", "equals": 50 },
    { "wait": 60 },
    { "expect": "buildings[2].charge", "approx": 100, "tolerance": 3 },
    { "expect": "ui.topBar.power", "equals": "0 / 60" },
    { "screenshot": "midday" },

    { "comment": "Night: the array gives nothing; a Drill Rig's 10 Power comes from the bank.", "placeBuilding": { "type": "DrillRig", "anchor": [44, 9] } },
    { "setTimeOfDay": 0.95 },
    { "wait": 1 },
    { "expect": "ui.topBar.clock", "equals": "22:48" },
    { "expect": "daylight", "equals": 0 },
    { "expect": "capacity.power.state", "equals": "normal" },
    { "expect": "capacity.power.storeFlow", "equals": -10 },
    { "expect": "ui.topBar.power", "equals": "10 / 10" },
    { "screenshot": "night" },

    { "comment": "A Fission Reactor on two Fuel Rods, cooled by two Water Pumps on the pond at map cell (13, 4).", "seedStockpile": { "type": "FuelRod", "amount": 2 } },
    { "changeTiles": { "type": "ShallowWater", "cells": [[13, 4]] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [52, 14] } },
    { "placeBuilding": { "type": "WaterPump", "anchor": [54, 14] } },
    { "placeBuilding": { "type": "FissionReactor", "anchor": [44, 12] } },
    { "setTimeOfDay": 0.5 },
    { "wait": 3 },
    { "expect": "buildings[6].online", "equals": true },
    { "expect": "capacity.water.demand", "equals": 8 },
    { "expect": "capacity.power.supply", "equals": 460 },
    { "expect": "stockpile.FuelRod", "equals": 1 },
    { "screenshot": "reactor" }
  ]
}
