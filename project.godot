; Engine configuration file.
; Hand-maintained for now; Godot will add generated keys on first open.

config_version=5

[application]

config/name="Game"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[dotnet]

project/assembly_name="Game"

[rendering]

; Compatibility renderer = OpenGL (ES 3 / 3.3). Chosen for broad hardware
; support (including Windows on ARM) and as a hands-on OpenGL refresher.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
